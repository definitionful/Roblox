        v3new(1, 1, -1), v3new(-1, 1, -1), v3new(1, -1, -1), v3new(-1, -1, -1),
        v3new(1, 0, 0), v3new(-1, 0, 0), v3new(0, 1, 0), v3new(0, -1, 0)
