    end

    local function validateCache(entity, data)
        local success, result = pcall(function()
            local isPlayer = typeof(entity) == "Instance" and entity:IsA("Player")
            local character
            
            if isPlayer then
                character = entity.Character
            else
                character = entity
            end
            
            if not character or not character.Parent then
                data.CachedParts = nil
                return nil
            end

            if data.CachedParts and data.CachedParts.Character == character and data.CachedParts.HRP and data.CachedParts.HRP.Parent and data.CachedParts.Humanoid and data.CachedParts.Humanoid.Parent then
                return data.CachedParts
            end

            local hrp = character:FindFirstChild("HumanoidRootPart") or character.PrimaryPart or character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso")
            local humanoid = character:FindFirstChildOfClass("Humanoid")
            
            if not hrp or not humanoid then
                data.CachedParts = nil
                return nil
            end

            local isR15 = character:FindFirstChild("UpperTorso") ~= nil
            local currentBones = isR15 and R15_BONES or R6_BONES
            local boneParts = {}

            for i, bonePair in ipairs(currentBones) do
                boneParts[i] = {
                    character:FindFirstChild(bonePair[1]),
                    character:FindFirstChild(bonePair[2])
                }
            end

            data.CachedParts = {
                HRP = hrp,
                Humanoid = humanoid,
                Head = character:FindFirstChild("Head"),
                BoneParts = boneParts,
                Character = character,
                IsPlayer = isPlayer
            }
            
            return data.CachedParts
        end)
        
        if success then return result else return nil end
    end

    local function checkVisibility(startPos, endPos, character, currentCamera)
        local success, result = pcall(function()
            local obscuring = currentCamera:GetPartsObscuringTarget({startPos, endPos}, filterList)
            for i = 1, #obscuring do
                local part = obscuring[i]
                if not part:IsDescendantOf(character) and part.Transparency < 0.5 and part.CanCollide then
                    return false
                end
            end
            return true
        end)
        return success and result or false
    end

    local function getClosestCharacterToMouse(mousePos, currentCamera, skipMultipoint)
        local success, r1, r2, r3 = pcall(function()
            if not currentCamera then return nil, nil, nil end

            local fovRadiusSq = Options.FOVRadius.Value * Options.FOVRadius.Value
            local visibleCheck = Toggles.VisibleCheck.Value
            local targetPartName = Options.Hitpart.Value
            local priority = Options.TargetPriority.Value
            local targetAllHumanoids = Toggles.TargetAllHumanoids.Value
            local ignoredTeams = Options.IgnoredTeams.Value
            local invisibleCheck = Toggles.InvisibleCheck.Value

            local localChar = LocalPlayer.Character
            table.clear(filterList)
            table.clear(entitiesList)
            table.clear(potentialTargetsList)

            table.insert(filterList, currentCamera)
            if localChar then table.insert(filterList, localChar) end
            if rayExceptionFolder then
                table.insert(filterList, rayExceptionFolder)
            elseif debrisFolder then
                table.insert(filterList, debrisFolder)
            end
            sharedRayParams.FilterDescendantsInstances = filterList

            local camCFramePos = currentCamera.CFrame.Position

            for entity, data in pairs(ESPCache) do
                local cached = validateCache(entity, data)
                if cached and cached.Humanoid.Health > 0 then
                    if not cached.IsPlayer and not targetAllHumanoids then continue end
                    if cached.IsPlayer and entity.Team then
                        if ignoredTeams and ignoredTeams[entity.Team.Name] then continue end
                    end
                    if invisibleCheck and cached.Head and cached.Head.Transparency >= 0.5 then continue end
                    table.insert(entitiesList, {
                        character = cached.Character,
                        head = cached.Head,
                        hrp = cached.HRP,
                        humanoid = cached.Humanoid
                    })
                end
            end

            local now = os.clock()
            for i = 1, #entitiesList do
                local entityObj = entitiesList[i]
                local targetPart
                
                if not TargetCache[entityObj.character] or not entityObj.character.Parent then
                    TargetCache[entityObj.character] = { part = nil, lastUpdate = 0 }
                end
                
                local cache = TargetCache[entityObj.character]
                if now - cache.lastUpdate >= 0.5 or not cache.part or not cache.part.Parent then
                    if targetPartName == 'Random' then
                        local parts = {}
                        for _, v in ipairs(entityObj.character:GetChildren()) do
                            if v:IsA("BasePart") and v.Name ~= "HumanoidRootPart" then
                                table.insert(parts, v)
                            end
                        end
                        if #parts > 0 then
                            cache.part = parts[math.random(1, #parts)]
                        else
                            cache.part = entityObj.hrp
                        end
                    else
                        cache.part = targetPartName == 'Head' and entityObj.head or entityObj.hrp
                    end
                    cache.lastUpdate = now
                end
                
                targetPart = cache.part
                if not targetPart or not targetPart.Parent then continue end

                local rootScreenPos, rootOnScreen = currentCamera:WorldToViewportPoint(targetPart.Position)
                if rootOnScreen then
                    local rx, ry = rootScreenPos.X - mousePos.X, rootScreenPos.Y - mousePos.Y
                    local rootDistSq = (rx * rx) + (ry * ry)
                    if rootDistSq > (fovRadiusSq * 3) then continue end
                end

                if not skipMultipoint then
                    local size = targetPart.Size * 0.8
                    local cf = targetPart.CFrame
                    local hx, hy, hz = size.X / 2, size.Y / 2, size.Z / 2
                     
                    for _, offset in ipairs(MULTIPOINT_OFFSETS) do
                        local point = cf * v3new(hx * offset.X, hy * offset.Y, hz * offset.Z)
                        local screenPos, onScreen = currentCamera:WorldToViewportPoint(point)
                        
                        if onScreen then
                            local px, py = screenPos.X - mousePos.X, screenPos.Y - mousePos.Y
                            local distSq = (px * px) + (py * py)
                            
                            if distSq <= fovRadiusSq then
                                table.insert(potentialTargetsList, {
                                    distanceSq = distSq, pos2D = v2new(screenPos.X, screenPos.Y),
                                    part = targetPart, hitPos = point, character = entityObj.character,
                                    health = entityObj.humanoid.Health, distance3D = (point - camCFramePos).Magnitude
                                })
                            end
                        end
                    end
                else
                    local point = targetPart.Position
                    local screenPos, onScreen = currentCamera:WorldToViewportPoint(point)
                    
                    if onScreen then
                        local px, py = screenPos.X - mousePos.X, screenPos.Y - mousePos.Y
                        local distSq = (px * px) + (py * py)
                        
                        if distSq <= fovRadiusSq then
                            table.insert(potentialTargetsList, {
                                distanceSq = distSq, pos2D = v2new(screenPos.X, screenPos.Y),
                                part = targetPart, hitPos = point, character = entityObj.character,
                                health = entityObj.humanoid.Health, distance3D = (point - camCFramePos).Magnitude
                            })
                        end
                    end
                end
            end

            table.sort(potentialTargetsList, function(a, b)
                if priority == 'Lowest Health' then return a.health < b.health
                elseif priority == 'Closest Distance' then return a.distance3D < b.distance3D
                else return a.distanceSq < b.distanceSq end
            end)

            for i = 1, #potentialTargetsList do
                local target = potentialTargetsList[i]
                if visibleCheck then
                    if checkVisibility(camCFramePos, target.hitPos, target.character, currentCamera) then
                        return target.pos2D, target.part, target.hitPos
                    end
                else
                    return target.pos2D, target.part, target.hitPos
                end
            end

            return nil, nil, nil
        end)
        
        if success then return r1, r2, r3 else return nil, nil, nil end
    end

    local fullbrightConnection
    local function updateFullbright()
        pcall(function()
            if Toggles.Fullbright.Value then
                if Lighting.Brightness ~= 2 then Lighting.Brightness = 2 end
                if Lighting.ClockTime ~= 14 then Lighting.ClockTime = 14 end
                if Lighting.FogEnd ~= 100000 then Lighting.FogEnd = 100000 end
                if Lighting.GlobalShadows ~= false then Lighting.GlobalShadows = false end
                if Lighting.OutdoorAmbient ~= Color3.fromRGB(128, 128, 128) then Lighting.OutdoorAmbient = Color3.fromRGB(128, 128, 128) end
            end
        end)
    end

    Toggles.Fullbright:OnChanged(function()
        pcall(function()
            if Toggles.Fullbright.Value then
                OriginalLighting.Brightness = Lighting.Brightness
                OriginalLighting.ClockTime = Lighting.ClockTime
                OriginalLighting.FogEnd = Lighting.FogEnd
                OriginalLighting.GlobalShadows = Lighting.GlobalShadows
                OriginalLighting.OutdoorAmbient = Lighting.OutdoorAmbient
                updateFullbright()
                fullbrightConnection = Lighting.Changed:Connect(updateFullbright)
            else
                if fullbrightConnection then
                    fullbrightConnection:Disconnect()
                    fullbrightConnection = nil
                end
                if OriginalLighting.Brightness then
                    Lighting.Brightness = OriginalLighting.Brightness
                    Lighting.ClockTime = OriginalLighting.ClockTime
                    Lighting.FogEnd = OriginalLighting.FogEnd
                    Lighting.GlobalShadows = OriginalLighting.GlobalShadows
                    Lighting.OutdoorAmbient = OriginalLighting.OutdoorAmbient
                end
            end
        end)
    end)

    local function updateVisualsForCache(cacheTable, currentCamera, camPos)
        pcall(function()
            local boxEnabled = Toggles.ESPBox.Value
            local skeletonEnabled = Toggles.ESPSkeleton.Value
            local nameEnabled = Toggles.ESPName.Value
            local teamNameEnabled = Toggles.ESPTeamName.Value
            local distanceEnabled = Toggles.ESPDistance.Value
            local healthEnabled = Toggles.ESPHealth.Value
            local healthGradientEnabled = Toggles.ESPHealthGradient.Value
            local healthTextEnabled = Toggles.ESPHealthText.Value
            local arrowsEnabled = Toggles.OffscreenArrows.Value
            local boxFillEnabled = Toggles.ESPBoxFill.Value
            local tracerEnabled = Toggles.ESPTracer.Value
            
            local boxColorVal = Options.BoxColor.Value
            local nameColorVal = Options.NameColor.Value
            local skelColorVal = Options.SkeletonColor.Value
            local boxTypeVal = Options.ESPBoxType.Value
            local arrowRadiusVal = Options.ArrowRadius.Value
            local arrowSizeVal = Options.ArrowSize.Value
            local arrowColorVal = Options.ArrowColor.Value
            local boxFillColorVal = Options.BoxFillColor.Value
            local boxFillTransVal = Options.ESPBoxFillTransparency.Value
            local tracerOriginVal = Options.ESPTracerOrigin.Value
            local tracerColorVal = Options.TracerColorESP.Value
            local tracerThicknessVal = Options.ESPTracerThickness.Value

            local teamColorEnabled = Toggles.ESPTeamColor.Value
            local toolEnabled = Toggles.ESPTool.Value
            local espTargetAllHumanoids = Toggles.ESPTargetAllHumanoids.Value
            local espTeamCheck = Toggles.ESPTeamCheck.Value
            local espInvisibleCheck = Toggles.ESPInvisibleCheck.Value
            local espVisibleCheck = Toggles.ESPVisibleCheck.Value

            local needsBox = boxEnabled or nameEnabled or distanceEnabled or healthEnabled or toolEnabled or healthTextEnabled or teamNameEnabled or boxFillEnabled or tracerEnabled

            table.clear(filterList)
            table.insert(filterList, currentCamera)
            if LocalPlayer.Character then table.insert(filterList, LocalPlayer.Character) end
            if rayExceptionFolder then table.insert(filterList, rayExceptionFolder) elseif debrisFolder then table.insert(filterList, debrisFolder) end
            sharedRayParams.FilterDescendantsInstances = filterList

            for entity, data in pairs(cacheTable) do
                local cached = validateCache(entity, data)
                if cached and cached.Humanoid.Health > 0 then
                    if not cached.IsPlayer and not espTargetAllHumanoids then
                        hideVisuals(data)
                        continue
                    end
                    
                    if cached.IsPlayer and espTeamCheck and entity.Team and LocalPlayer.Team and entity.Team == LocalPlayer.Team then
                        hideVisuals(data)
                        continue
                    end
                    
                    if espInvisibleCheck and cached.Head and cached.Head.Transparency >= 0.5 then
                        hideVisuals(data)
                        continue
                    end
                    
                    if espVisibleCheck then
                        if not checkVisibility(camPos, cached.HRP.Position, cached.Character, currentCamera) then
                            hideVisuals(data)
                            continue
                        end
                    end

                    local hrp = cached.HRP
                    local humanoid = cached.Humanoid
                    local character = cached.Character
                    local distanceToCam = (camPos - hrp.Position).Magnitude
                    
                    local hasTeamColor = false
                    local espColor = Color3.new(1, 1, 1)
                    
                    if teamColorEnabled and cached.IsPlayer and entity.Team then
                        espColor = entity.TeamColor.Color
                        hasTeamColor = true
                    end

                    local currentBoxColor = hasTeamColor and espColor or (boxColorVal or espColor)
                    local currentNameColor = hasTeamColor and espColor or (nameColorVal or espColor)
                    local currentSkeletonColor = hasTeamColor and espColor or (skelColorVal or espColor)

                    local topPos, bottomPos, onScreenTop, onScreenBottom
                    local isBoxVisible = false
                    
                    if needsBox then
                        topPos, onScreenTop = currentCamera:WorldToViewportPoint(hrp.Position + BOX_TOP_OFFSET)
                        bottomPos, onScreenBottom = currentCamera:WorldToViewportPoint(hrp.Position - BOX_BOTTOM_OFFSET)
                        isBoxVisible = onScreenTop or onScreenBottom
                    end

                    if arrowsEnabled and not isBoxVisible then
                        local pointToObjectSpace = currentCamera.CFrame:PointToObjectSpace(hrp.Position)
                        local angle = matan2(pointToObjectSpace.X, pointToObjectSpace.Y) - (mpi / 2)
                        if pointToObjectSpace.Z > 0 then angle = angle + mpi end
                        
                        local cx = currentCamera.ViewportSize.X / 2
                        local cy = currentCamera.ViewportSize.Y / 2
                        
                        local arrowCenter = v2new(cx + mcos(angle) * arrowRadiusVal, cy + msin(angle) * arrowRadiusVal)
                        local p1 = arrowCenter + v2new(mcos(angle) * arrowSizeVal, msin(angle) * arrowSizeVal)
                        local p2 = arrowCenter + v2new(mcos(angle - 2.5) * arrowSizeVal, msin(angle - 2.5) * arrowSizeVal)
                        local p3 = arrowCenter + v2new(mcos(angle + 2.5) * arrowSizeVal, msin(angle + 2.5) * arrowSizeVal)
                        
                        setDrawingProp(data.OffscreenArrow, "PointA", p1)
                        setDrawingProp(data.OffscreenArrow, "PointB", p2)
                        setDrawingProp(data.OffscreenArrow, "PointC", p3)
                        setDrawingProp(data.OffscreenArrow, "Color", arrowColorVal)
                        setDrawingProp(data.OffscreenArrow, "Visible", true)
                    else
                        setDrawingProp(data.OffscreenArrow, "Visible", false)
                    end

                    if isBoxVisible then
                        local boxHeight = mabs(topPos.Y - bottomPos.Y)
                        local boxWidth = boxHeight * 0.625
                        local boxX = topPos.X - (boxWidth / 2)
                        local boxY = topPos.Y

                        if boxEnabled then
                            if boxTypeVal == 'Corner' then
                                setDrawingProp(data.Box, "Visible", false)
                                local lineW = boxWidth / 3
                                local lineH = boxHeight / 4
                                data.CornerBox[1].From = v2new(boxX, boxY)
                                data.CornerBox[1].To = v2new(boxX + lineW, boxY)
                                data.CornerBox[2].From = v2new(boxX, boxY)
                                data.CornerBox[2].To = v2new(boxX, boxY + lineH)
                                data.CornerBox[3].From = v2new(boxX + boxWidth, boxY)
                                data.CornerBox[3].To = v2new(boxX + boxWidth - lineW, boxY)
                                data.CornerBox[4].From = v2new(boxX + boxWidth, boxY)
                                data.CornerBox[4].To = v2new(boxX + boxWidth, boxY + lineH)
                                data.CornerBox[5].From = v2new(boxX, boxY + boxHeight)
                                data.CornerBox[5].To = v2new(boxX + lineW, boxY + boxHeight)
                                data.CornerBox[6].From = v2new(boxX, boxY + boxHeight)
                                data.CornerBox[6].To = v2new(boxX, boxY + boxHeight - lineH)
                                data.CornerBox[7].From = v2new(boxX + boxWidth, boxY + boxHeight)
                                data.CornerBox[7].To = v2new(boxX + boxWidth - lineW, boxY + boxHeight)
                                data.CornerBox[8].From = v2new(boxX + boxWidth, boxY + boxHeight)
                                data.CornerBox[8].To = v2new(boxX + boxWidth, boxY + boxHeight - lineH)
                                
                                for i = 1, 8 do
                                    setDrawingProp(data.CornerBox[i], "Color", currentBoxColor)
                                    setDrawingProp(data.CornerBox[i], "Visible", true)
                                end
                            else
                                for i = 1, 8 do setDrawingProp(data.CornerBox[i], "Visible", false) end
                                setDrawingProp(data.Box, "Position", v2new(boxX, boxY))
                                setDrawingProp(data.Box, "Size", v2new(boxWidth, boxHeight))
                                setDrawingProp(data.Box, "Color", currentBoxColor)
                                setDrawingProp(data.Box, "Visible", true)
                            end
                        else
                            setDrawingProp(data.Box, "Visible", false)
                            for i = 1, 8 do setDrawingProp(data.CornerBox[i], "Visible", false) end
                        end

                        if boxFillEnabled then
                            setDrawingProp(data.BoxFill, "Position", v2new(boxX, boxY))
                            setDrawingProp(data.BoxFill, "Size", v2new(boxWidth, boxHeight))
                            setDrawingProp(data.BoxFill, "Color", boxFillColorVal)
                            setDrawingProp(data.BoxFill, "Transparency", boxFillTransVal)
                            setDrawingProp(data.BoxFill, "Visible", true)
                        else
                            setDrawingProp(data.BoxFill, "Visible", false)
                        end

                        if tracerEnabled then
                            local origin = v2new(currentCamera.ViewportSize.X / 2, currentCamera.ViewportSize.Y)
                            if tracerOriginVal == 'Top Center' then
                                origin = v2new(currentCamera.ViewportSize.X / 2, 0)
                            elseif tracerOriginVal == 'Mouse' then
                                origin = UserInputService:GetMouseLocation()
                            end
                            data.Tracer.From = origin
                            data.Tracer.To = v2new(boxX + (boxWidth / 2), bottomPos.Y)
                            setDrawingProp(data.Tracer, "Color", tracerColorVal)
                            setDrawingProp(data.Tracer, "Thickness", tracerThicknessVal)
                            setDrawingProp(data.Tracer, "Visible", true)
                        else
                            setDrawingProp(data.Tracer, "Visible", false)
                        end

                        if nameEnabled then
                            setDrawingProp(data.NameTag, "Text", character.Name)
                            setDrawingProp(data.NameTag, "Position", v2new(topPos.X, boxY - 16))
                            setDrawingProp(data.NameTag, "Color", currentNameColor)
                            setDrawingProp(data.NameTag, "Visible", true)
                        else
                            setDrawingProp(data.NameTag, "Visible", false)
                        end

                        local yOffset = bottomPos.Y + 2
                        
                        if distanceEnabled then
                            setDrawingProp(data.DistanceTag, "Text", tostring(mfloor(distanceToCam)) .. "m")
                            setDrawingProp(data.DistanceTag, "Position", v2new(topPos.X, yOffset))
                            setDrawingProp(data.DistanceTag, "Color", currentNameColor)
                            setDrawingProp(data.DistanceTag, "Visible", true)
                            yOffset = yOffset + 14
                        else
                            setDrawingProp(data.DistanceTag, "Visible", false)
                        end

                        if teamNameEnabled then
                            setDrawingProp(data.TeamTag, "Text", cached.IsPlayer and entity.Team and entity.Team.Name or "None")
                            setDrawingProp(data.TeamTag, "Position", v2new(topPos.X, yOffset))
                            setDrawingProp(data.TeamTag, "Color", currentNameColor)
                            setDrawingProp(data.TeamTag, "Visible", true)
                            yOffset = yOffset + 14
                        else
                            setDrawingProp(data.TeamTag, "Visible", false)
                        end

                        if toolEnabled then
                            local tool = character:FindFirstChildOfClass("Tool")
                            setDrawingProp(data.ToolTag, "Text", tool and tool.Name or "None")
                            setDrawingProp(data.ToolTag, "Position", v2new(topPos.X, yOffset))
                            setDrawingProp(data.ToolTag, "Color", currentNameColor)
                            setDrawingProp(data.ToolTag, "Visible", true)
                            yOffset = yOffset + 14
                        else
                            setDrawingProp(data.ToolTag, "Visible", false)
                        end

                        local healthPercent = mclamp(humanoid.Health / (humanoid.MaxHealth > 0 and humanoid.MaxHealth or 100), 0, 1)
                        local barWidth = 3
                        local barOffset = 5
                        local barX = boxX - barOffset - barWidth
                        local healthHeight = boxHeight * healthPercent
                        local healthColor = Color3.fromRGB(255, 0, 0):Lerp(Color3.fromRGB(0, 255, 0), healthPercent)

                        if healthEnabled then
                            if healthGradientEnabled then
                                setDrawingProp(data.HealthBarBg, "Position", v2new(barX, boxY))
                                setDrawingProp(data.HealthBarBg, "Size", v2new(barWidth, boxHeight))
                                setDrawingProp(data.HealthBarBg, "Visible", true)
                                setDrawingProp(data.HealthBar, "Visible", false)
                                
                                local segCount = 15
                                local activeSegs = math.ceil(healthPercent * segCount)
                                local segHeight = boxHeight / segCount
                                
                                for i = 1, 15 do
                                    local seg = data.HealthSegments[i]
                                    if i <= activeSegs then
                                        local t = (i - 1) / (segCount - 1)
                                        local segColor = Color3.fromRGB(255, 0, 0):Lerp(Color3.fromRGB(0, 255, 0), t)
                                        local sY = boxY + boxHeight - (i * segHeight)
                                        setDrawingProp(seg, "Position", v2new(barX, sY))
                                        setDrawingProp(seg, "Size", v2new(barWidth, segHeight))
                                        setDrawingProp(seg, "Color", segColor)
                                        setDrawingProp(seg, "Visible", true)
                                    else
                                        setDrawingProp(seg, "Visible", false)
                                    end
                                end
                            else
                                for i = 1, 15 do setDrawingProp(data.HealthSegments[i], "Visible", false) end
                                setDrawingProp(data.HealthBarBg, "Position", v2new(barX, boxY))
                                setDrawingProp(data.HealthBarBg, "Size", v2new(barWidth, boxHeight))
                                setDrawingProp(data.HealthBarBg, "Visible", true)
                                
                                setDrawingProp(data.HealthBar, "Position", v2new(barX, boxY + (boxHeight - healthHeight)))
                                setDrawingProp(data.HealthBar, "Size", v2new(barWidth, healthHeight))
                                setDrawingProp(data.HealthBar, "Color", healthColor)
                                setDrawingProp(data.HealthBar, "Visible", true)
                            end
                        else
                            setDrawingProp(data.HealthBarBg, "Visible", false)
                            setDrawingProp(data.HealthBar, "Visible", false)
                            for i = 1, 15 do setDrawingProp(data.HealthSegments[i], "Visible", false) end
                        end

                        if healthTextEnabled then
                            setDrawingProp(data.HealthTextTag, "Text", tostring(mfloor(humanoid.Health)) .. " HP")
                            setDrawingProp(data.HealthTextTag, "Position", v2new(barX - 18, boxY + (boxHeight - healthHeight) - 6))
                            setDrawingProp(data.HealthTextTag, "Color", healthColor)
                            setDrawingProp(data.HealthTextTag, "Visible", true)
                        else
                            setDrawingProp(data.HealthTextTag, "Visible", false)
                        end

                    else
                        setDrawingProp(data.Box, "Visible", false)
                        setDrawingProp(data.BoxFill, "Visible", false)
                        setDrawingProp(data.Tracer, "Visible", false)
                        for i = 1, 8 do setDrawingProp(data.CornerBox[i], "Visible", false) end
                        setDrawingProp(data.HealthBarBg, "Visible", false)
                        setDrawingProp(data.HealthBar, "Visible", false)
                        for i = 1, 15 do setDrawingProp(data.HealthSegments[i], "Visible", false) end
                        setDrawingProp(data.NameTag, "Visible", false)
                        setDrawingProp(data.TeamTag, "Visible", false)
                        setDrawingProp(data.DistanceTag, "Visible", false)
                        setDrawingProp(data.HealthTextTag, "Visible", false)
                        setDrawingProp(data.ToolTag, "Visible", false)
                    end

                    if skeletonEnabled and distanceToCam <= 1000 then
                        local currentBones = cached.BoneParts
                        for i, line in ipairs(data.Skeleton) do
                            local parts = currentBones[i]
                            if parts then
                                local partA, partB = parts[1], parts[2]
                                if partA and partB and partA.Parent and partB.Parent then
                                    local posA, onScreenA = currentCamera:WorldToViewportPoint(partA.Position)
                                    local posB, onScreenB = currentCamera:WorldToViewportPoint(partB.Position)
                                    
                                    if onScreenA and onScreenB then
                                        line.From = v2new(posA.X, posA.Y)
                                        line.To = v2new(posB.X, posB.Y)
                                        setDrawingProp(line, "Color", currentSkeletonColor)
                                        setDrawingProp(line, "Visible", true)
                                    else
                                        setDrawingProp(line, "Visible", false)
                                    end
                                else
                                    setDrawingProp(line, "Visible", false)
                                end
                            else
                                setDrawingProp(line, "Visible", false)
                            end
                        end
                    else
                        for i = 1, 14 do setDrawingProp(data.Skeleton[i], "Visible", false) end
                    end
                else
                    hideVisuals(data)
                end
            end
        end)
    end

    local espWasEnabled = false
    local silentAimTarget = { pos2D = nil, part = nil, hitPos = nil, willHit = false }

    table.insert(Connections, RunService.RenderStepped:Connect(function()
        pcall(function()
            local currentCamera = Workspace.CurrentCamera
            if not currentCamera then return end

            local mousePos = UserInputService:GetMouseLocation()
            local requireTarget = Toggles.SilentAimEnabled.Value or Toggles.TracerEnabled.Value
            
            if requireTarget then
                local skipMultipoint = not Toggles.SilentAimEnabled.Value
                local pos2D, hitPart, hitPos = getClosestCharacterToMouse(mousePos, currentCamera, skipMultipoint)
                silentAimTarget.pos2D = pos2D
                silentAimTarget.part = hitPart
                silentAimTarget.hitPos = hitPos
                silentAimTarget.willHit = CalculateChance(Options.Hitchance.Value)
            else
                silentAimTarget.pos2D = nil
                silentAimTarget.part = nil
                silentAimTarget.hitPos = nil
                silentAimTarget.willHit = false
            end

            local outlineEnabled = Toggles.FOVOutline.Value
            local filledEnabled = Toggles.FOVFilled.Value
            local fovRadius = Options.FOVRadius.Value
            local fovNumSides = Options.FOVNumSides.Value

            setDrawingProp(FOVCircle, "Visible", outlineEnabled)
            setDrawingProp(FOVFilledCircle, "Visible", filledEnabled)

            if outlineEnabled then
                setDrawingProp(FOVCircle, "Position", mousePos)
                setDrawingProp(FOVCircle, "Radius", fovRadius)
                setDrawingProp(FOVCircle, "Thickness", Options.FOVThickness.Value)
                setDrawingProp(FOVCircle, "NumSides", fovNumSides)
                setDrawingProp(FOVCircle, "Color", Options.FOVOutlineColor.Value)
            end

            if filledEnabled then
                setDrawingProp(FOVFilledCircle, "Position", mousePos)
                setDrawingProp(FOVFilledCircle, "Radius", fovRadius)
                setDrawingProp(FOVFilledCircle, "NumSides", fovNumSides)
                setDrawingProp(FOVFilledCircle, "Color", Options.FOVFilledColor.Value)
                setDrawingProp(FOVFilledCircle, "Transparency", Options.FOVFilledTransparency.Value)
            end

            local tracerEnabled = Toggles.TracerEnabled.Value

            if tracerEnabled and silentAimTarget.pos2D then
                setDrawingProp(TracerLine, "Visible", true)
                setDrawingProp(TracerLine, "From", mousePos)
                setDrawingProp(TracerLine, "To", silentAimTarget.pos2D)
                setDrawingProp(TracerLine, "Color", Options.TracerColor.Value)
                setDrawingProp(TracerLine, "Thickness", Options.TracerThickness.Value)
            else
                setDrawingProp(TracerLine, "Visible", false)
            end

            local camPos = currentCamera.CFrame.Position
            
            if Toggles.ESPEnabled.Value then
                updateVisualsForCache(ESPCache, currentCamera, camPos)
                espWasEnabled = true
            elseif espWasEnabled then
                for _, data in pairs(ESPCache) do hideVisuals(data) end
                espWasEnabled = false
            end
        end)
    end))

    local ExpectedArguments = {
        FindPartOnRayWithIgnoreList = { ArgCountRequired = 3, Args = { "Instance", "Ray", "table", "boolean", "boolean" } },
        FindPartOnRayWithWhitelist = { ArgCountRequired = 3, Args = { "Instance", "Ray", "table", "boolean" } },
        FindPartOnRay = { ArgCountRequired = 2, Args = { "Instance", "Ray", "Instance", "boolean", "boolean" } },
        Raycast = { ArgCountRequired = 3, Args = { "Instance", "Vector3", "Vector3", "RaycastParams" } }
    }

    local function ValidateArguments(Args, RayMethod)
        local success, result = pcall(function()
            local Matches = 0
            if #Args < RayMethod.ArgCountRequired then return false end
            for Pos, Argument in next, Args do
                if typeof(Argument) == RayMethod.Args[Pos] then Matches = Matches + 1 end
            end
            return Matches >= RayMethod.ArgCountRequired
        end)
        return success and result or false
    end

    local function getDirection(Origin, Position)
        return (Position - Origin).Unit * 1000
    end

    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(...)
        local method = tostring(getnamecallmethod())
        local args = {...}
        local self = args[1]
        
        if Library and Library.Unloaded then return oldNamecall(...) end

        if not checkcaller() then
            local success, returnObj = pcall(function()
                if method == "GetMouseLocation" or method == "getMouseLocation" then
                    if self == UserInputService and Toggles.SilentAimEnabled.Value and silentAimTarget.pos2D and silentAimTarget.willHit then
                        return silentAimTarget.pos2D
                    end
                end

                if Toggles.SilentAimEnabled.Value and self == Workspace and silentAimTarget.willHit then
                    local calling_script = getcallingscript and getcallingscript()
                    if calling_script and (calling_script.Name == "CameraModule" or calling_script.Name == "Poppercam" or calling_script.Name == "ZoomController" or calling_script.Name == "TransparencyController") then
                        return nil
                    end
                    
                    local HitPart = silentAimTarget.part
                    local HitPos = silentAimTarget.hitPos

                    if HitPart and HitPos then
                        local silentMethod = Options.SilentAimMethod.Value
                        if method == "Raycast" and silentMethod == 'Raycast' then
                            if ValidateArguments(args, ExpectedArguments.Raycast) then
                                args[3] = getDirection(args[2], HitPos)
                                return args
                            end
                        elseif method == "FindPartOnRayWithIgnoreList" and silentMethod == method then
                            if ValidateArguments(args, ExpectedArguments.FindPartOnRayWithIgnoreList) then
                                local Origin = args[2].Origin
                                args[2] = Ray.new(Origin, getDirection(Origin, HitPos))
                                return args
                            end
                        elseif method == "FindPartOnRayWithWhitelist" and silentMethod == method then
                            if ValidateArguments(args, ExpectedArguments.FindPartOnRayWithWhitelist) then
                                local Origin = args[2].Origin
                                args[2] = Ray.new(Origin, getDirection(Origin, HitPos))
                                return args
                            end
                        elseif (method == "FindPartOnRay" or method == "findPartOnRay") and silentMethod == "FindPartOnRay" then
                            if ValidateArguments(args, ExpectedArguments.FindPartOnRay) then
                                local Origin = args[2].Origin
                                args[2] = Ray.new(Origin, getDirection(Origin, HitPos))
                                return args
                            end
                        end
                    end
                end
                return nil
            end)

            if success and returnObj ~= nil then
                if type(returnObj) == "table" and returnObj[1] == self then
                    return oldNamecall(unpack(returnObj))
                else
                    return returnObj
                end
            end
        end
        
        return oldNamecall(...)
    end))

    local oldIndex = nil 
    oldIndex = hookmetamethod(game, "__index", newcclosure(function(self, Index)
        if checkcaller() or (Library and Library.Unloaded) then return oldIndex(self, Index) end

        local success, result = pcall(function()
            if self == PlayerMouse and Toggles.SilentAimEnabled.Value and silentAimTarget.willHit then
                if Index == "Target" or Index == "target" then 
                    if Options.SilentAimMethod.Value == 'Mouse.Hit' and silentAimTarget.part then return silentAimTarget.part end
                elseif Index == "Hit" or Index == "hit" then 
                    if Options.SilentAimMethod.Value == 'Mouse.Hit' and silentAimTarget.hitPos then return CFrame.new(silentAimTarget.hitPos) end
                elseif Index == "X" or Index == "x" then
                    if silentAimTarget.pos2D then return silentAimTarget.pos2D.X end
                elseif Index == "Y" or Index == "y" then
                    if silentAimTarget.pos2D then return silentAimTarget.pos2D.Y end
                end
            end
            return nil
        end)
        
        if success and result ~= nil then return result end
        return oldIndex(self, Index)
    end))

    SaveManager:LoadAutoloadConfig()

    Library:OnUnload(function()
        pcall(function()
            for _, conn in ipairs(Connections) do pcall(function() conn:Disconnect() end) end
            if FOVCircle then pcall(function() FOVCircle:Remove() end) end
            if FOVFilledCircle then pcall(function() FOVFilledCircle:Remove() end) end
            if TracerLine then pcall(function() TracerLine:Remove() end) end
            table.clear(drawingPropCache)
            
            if fullbrightConnection then pcall(function() fullbrightConnection:Disconnect() end) end
            
            for player, _ in pairs(ESPCache) do removeESPData(ESPCache, player) end
            
            if OriginalLighting.Brightness then
                pcall(function()
                    Lighting.Brightness = OriginalLighting.Brightness
                    Lighting.ClockTime = OriginalLighting.ClockTime
                    Lighting.FogEnd = OriginalLighting.FogEnd
                    Lighting.GlobalShadows = OriginalLighting.GlobalShadows
                    Lighting.OutdoorAmbient = OriginalLighting.OutdoorAmbient
                end)
            end
            
            Library.Unloaded = true
        end)
    end)
end)
