    local function CalculateChance(Percentage)
        return math.random(1, 100) <= Percentage
    end

    local function createESPData(cacheTable, key)
        pcall(function()
            if cacheTable[key] then return end
            local data = {
                Skeleton = {}, CornerBox = {}, HealthSegments = {},
                Box = Drawing.new("Square"), BoxFill = Drawing.new("Square"),
                HealthBarBg = Drawing.new("Square"), HealthBar = Drawing.new("Square"),
                NameTag = Drawing.new("Text"), TeamTag = Drawing.new("Text"),
                DistanceTag = Drawing.new("Text"), HealthTextTag = Drawing.new("Text"),
                ToolTag = Drawing.new("Text"), OffscreenArrow = Drawing.new("Triangle"),
                Tracer = Drawing.new("Line"), CachedParts = nil, Connections = {}
            }

            setDrawingProp(data.Box, "Thickness", 1.5)
            setDrawingProp(data.Box, "Filled", false)
            setDrawingProp(data.Box, "Visible", false)
            setDrawingProp(data.BoxFill, "Filled", true)
            setDrawingProp(data.BoxFill, "Thickness", 0)
            setDrawingProp(data.BoxFill, "Visible", false)
            setDrawingProp(data.HealthBarBg, "Color", Color3.fromRGB(40, 40, 40))
            setDrawingProp(data.HealthBarBg, "Filled", true)
            setDrawingProp(data.HealthBarBg, "Thickness", 0)
            setDrawingProp(data.HealthBarBg, "Visible", false)
            setDrawingProp(data.HealthBar, "Filled", true)
            setDrawingProp(data.HealthBar, "Thickness", 0)
            setDrawingProp(data.HealthBar, "Visible", false)

            local textTags = {data.NameTag, data.TeamTag, data.DistanceTag, data.HealthTextTag, data.ToolTag}
            for _, tag in ipairs(textTags) do
                setDrawingProp(tag, "Size", 13)
                setDrawingProp(tag, "Center", true)
                setDrawingProp(tag, "Outline", true)
                setDrawingProp(tag, "Visible", false)
            end
            
            setDrawingProp(data.OffscreenArrow, "Thickness", 1.5)
            setDrawingProp(data.OffscreenArrow, "Filled", true)
            setDrawingProp(data.OffscreenArrow, "Visible", false)
            setDrawingProp(data.Tracer, "Visible", false)

            for i = 1, 14 do
                local line = Drawing.new("Line")
                setDrawingProp(line, "Thickness", 1.5)
                setDrawingProp(line, "Visible", false)
                table.insert(data.Skeleton, line)
            end

            for i = 1, 8 do
                local line = Drawing.new("Line")
                setDrawingProp(line, "Thickness", 1.5)
                setDrawingProp(line, "Visible", false)
                table.insert(data.CornerBox, line)
            end
            
            for i = 1, 15 do
                local seg = Drawing.new("Square")
                setDrawingProp(seg, "Filled", true)
                setDrawingProp(seg, "Thickness", 0)
                setDrawingProp(seg, "Visible", false)
                table.insert(data.HealthSegments, seg)
            end

            cacheTable[key] = data
        end)
    end

    local function removeESPData(cacheTable, key)
        pcall(function()
            if cacheTable[key] then
                local data = cacheTable[key]
                for _, conn in ipairs(data.Connections) do pcall(function() conn:Disconnect() end) end
                for i = 1, 14 do pcall(function() data.Skeleton[i]:Remove(); drawingPropCache[data.Skeleton[i]] = nil end) end
                for i = 1, 8 do pcall(function() data.CornerBox[i]:Remove(); drawingPropCache[data.CornerBox[i]] = nil end) end
                for i = 1, 15 do pcall(function() data.HealthSegments[i]:Remove(); drawingPropCache[data.HealthSegments[i]] = nil end) end
                pcall(function() data.Box:Remove(); drawingPropCache[data.Box] = nil end)
                pcall(function() data.BoxFill:Remove(); drawingPropCache[data.BoxFill] = nil end)
                pcall(function() data.HealthBarBg:Remove(); drawingPropCache[data.HealthBarBg] = nil end)
                pcall(function() data.HealthBar:Remove(); drawingPropCache[data.HealthBar] = nil end)
                pcall(function() data.NameTag:Remove(); drawingPropCache[data.NameTag] = nil end)
                pcall(function() data.TeamTag:Remove(); drawingPropCache[data.TeamTag] = nil end)
                pcall(function() data.DistanceTag:Remove(); drawingPropCache[data.DistanceTag] = nil end)
                pcall(function() data.HealthTextTag:Remove(); drawingPropCache[data.HealthTextTag] = nil end)
                pcall(function() data.ToolTag:Remove(); drawingPropCache[data.ToolTag] = nil end)
                pcall(function() data.OffscreenArrow:Remove(); drawingPropCache[data.OffscreenArrow] = nil end)
                pcall(function() data.Tracer:Remove(); drawingPropCache[data.Tracer] = nil end)
                cacheTable[key] = nil
            end
        end)
    end

    local function AddToNPCCache(model)
        pcall(function()
            if not model or not model:IsA("Model") or model == LocalPlayer.Character then return end
            if model:FindFirstChildOfClass("Humanoid") then
                NPCCache[model] = true
                createESPData(ESPCache, model)
            end
        end)
    end

    for _, v in ipairs(Workspace:GetDescendants()) do
        if v:IsA("Model") then AddToNPCCache(v) end
    end

    table.insert(Connections, Workspace.DescendantAdded:Connect(function(v)
        pcall(function()
            if v:IsA("Humanoid") and v.Parent and v.Parent:IsA("Model") then
                AddToNPCCache(v.Parent)
            elseif v:IsA("Model") then
                task.delay(1, function()
                    pcall(function()
                        if v and v.Parent then AddToNPCCache(v) end
                    end)
                end)
            end
        end)
    end))

    table.insert(Connections, Workspace.DescendantRemoving:Connect(function(v)
        pcall(function()
            if v:IsA("Model") and NPCCache[v] then
                NPCCache[v] = nil
                removeESPData(ESPCache, v)
            end
        end)
    end))

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then createESPData(ESPCache, player) end
    end

    table.insert(Connections, Players.PlayerAdded:Connect(function(player)
        pcall(function()
            if player ~= LocalPlayer then createESPData(ESPCache, player) end
        end)
    end))

    table.insert(Connections, Players.PlayerRemoving:Connect(function(player)
        pcall(function() removeESPData(ESPCache, player) end)
    end))

