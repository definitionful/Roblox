local function hideVisuals(data)
    for i = 1, 14 do setDrawingProp(data.Skeleton[i], "Visible", false) end
    for i = 1, 8 do setDrawingProp(data.CornerBox[i], "Visible", false) end
    setDrawingProp(data.Box, "Visible", false)
    setDrawingProp(data.HealthBarBg, "Visible", false)
    setDrawingProp(data.HealthBar, "Visible", false)
    setDrawingProp(data.NameTag, "Visible", false)
    setDrawingProp(data.DistanceTag, "Visible", false)
    setDrawingProp(data.HealthTextTag, "Visible", false)
    setDrawingProp(data.ToolTag, "Visible", false)
end

local function validateCache(entity, data)
    local character = entity.Character
    if not character or not character.Parent then
        data.CachedParts = nil
        return nil
    end

    if data.CachedParts and data.CachedParts.Character == character and data.CachedParts.HRP and data.CachedParts.HRP.Parent and data.CachedParts.Humanoid and data.CachedParts.Humanoid.Parent then
        return data.CachedParts
    end

    local hrp = character:FindFirstChild("HumanoidRootPart") or character.PrimaryPart or character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso")
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    
    if not hrp or not humanoid then
        data.CachedParts = nil
        return nil
    end

    local isR15 = character:FindFirstChild("UpperTorso") ~= nil
    local currentBones = isR15 and R15_BONES or R6_BONES
    local boneParts = {}

    for i, bonePair in ipairs(currentBones) do
        boneParts[i] = {
            character:FindFirstChild(bonePair[1]),
            character:FindFirstChild(bonePair[2])
        }
    end

    data.CachedParts = {
        HRP = hrp,
        Humanoid = humanoid,
        BoneParts = boneParts,
        Character = character
    }
    
    return data.CachedParts
end

local function createESPData(cacheTable, key)
    if cacheTable[key] then return end
    
    local data = {
        Skeleton = {},
        CornerBox = {},
        Box = Drawing.new("Square"),
        HealthBarBg = Drawing.new("Square"),
        HealthBar = Drawing.new("Square"),
        NameTag = Drawing.new("Text"),
        DistanceTag = Drawing.new("Text"),
        HealthTextTag = Drawing.new("Text"),
        ToolTag = Drawing.new("Text"),
        CachedParts = nil,
        Connections = {}
    }

    setDrawingProp(data.Box, "Thickness", 1.5)
    setDrawingProp(data.Box, "Filled", false)
    setDrawingProp(data.Box, "Visible", false)

    setDrawingProp(data.HealthBarBg, "Color", Color3.fromRGB(40, 40, 40))
    setDrawingProp(data.HealthBarBg, "Filled", true)
    setDrawingProp(data.HealthBarBg, "Thickness", 0)
    setDrawingProp(data.HealthBarBg, "Visible", false)

    setDrawingProp(data.HealthBar, "Filled", true)
    setDrawingProp(data.HealthBar, "Thickness", 0)
    setDrawingProp(data.HealthBar, "Visible", false)

    setDrawingProp(data.NameTag, "Size", 13)
    setDrawingProp(data.NameTag, "Center", true)
    setDrawingProp(data.NameTag, "Outline", true)
    setDrawingProp(data.NameTag, "Visible", false)

    setDrawingProp(data.DistanceTag, "Size", 13)
    setDrawingProp(data.DistanceTag, "Center", true)
    setDrawingProp(data.DistanceTag, "Outline", true)
    setDrawingProp(data.DistanceTag, "Visible", false)

    setDrawingProp(data.HealthTextTag, "Size", 13)
    setDrawingProp(data.HealthTextTag, "Center", true)
    setDrawingProp(data.HealthTextTag, "Outline", true)
    setDrawingProp(data.HealthTextTag, "Visible", false)

    setDrawingProp(data.ToolTag, "Size", 13)
    setDrawingProp(data.ToolTag, "Center", true)
    setDrawingProp(data.ToolTag, "Outline", true)
    setDrawingProp(data.ToolTag, "Visible", false)

    for i = 1, 14 do
        local line = Drawing.new("Line")
        setDrawingProp(line, "Thickness", 1.5)
        setDrawingProp(line, "Visible", false)
        table.insert(data.Skeleton, line)
    end

    for i = 1, 8 do
        local line = Drawing.new("Line")
        setDrawingProp(line, "Thickness", 1.5)
        setDrawingProp(line, "Visible", false)
        table.insert(data.CornerBox, line)
    end

    cacheTable[key] = data
end

local function removeESPData(cacheTable, key)
    if cacheTable[key] then
        local data = cacheTable[key]
        
        for _, conn in ipairs(data.Connections) do
            conn:Disconnect()
        end
        for i = 1, 14 do data.Skeleton[i]:Remove() end
        for i = 1, 8 do data.CornerBox[i]:Remove() end
        data.Box:Remove()
        data.HealthBarBg:Remove()
        data.HealthBar:Remove()
        data.NameTag:Remove()
        data.DistanceTag:Remove()
        data.HealthTextTag:Remove()
        data.ToolTag:Remove()
        
        drawingPropCache[data.Box] = nil
        drawingPropCache[data.HealthBarBg] = nil
        drawingPropCache[data.HealthBar] = nil
        drawingPropCache[data.NameTag] = nil
        drawingPropCache[data.DistanceTag] = nil
        drawingPropCache[data.HealthTextTag] = nil
        drawingPropCache[data.ToolTag] = nil
        for i = 1, 14 do drawingPropCache[data.Skeleton[i]] = nil end
        for i = 1, 8 do drawingPropCache[data.CornerBox[i]] = nil end
        
        cacheTable[key] = nil
    end
end

for _, player in ipairs(Players:GetPlayers()) do
    if player ~= LocalPlayer then createESPData(ESPCache, player) end
end

table.insert(Connections, Players.PlayerAdded:Connect(function(player)
    if player ~= LocalPlayer then createESPData(ESPCache, player) end
end))

table.insert(Connections, Players.PlayerRemoving:Connect(function(player)
    removeESPData(ESPCache, player)
end))

local function checkVisibility(startPos, endPos, character)
    local direction = endPos - startPos
    table.clear(dynamicFilterList)
    
    for i = 1, #filterList do
        dynamicFilterList[i] = filterList[i]
    end

    for i = 1, 5 do
        sharedVisibilityParams.FilterDescendantsInstances = dynamicFilterList
        local result = Workspace:Raycast(startPos, direction, sharedVisibilityParams)
        
        if not result or result.Instance:IsDescendantOf(character) then
            return true
        end
        
        if result.Instance.Transparency > 0.5 or not result.Instance.CanCollide then
            table.insert(dynamicFilterList, result.Instance)
        else
            return false
        end
    end
    return false
end

local function getClosestCharacterToMouse(mousePos, currentCamera, skipMultipoint)
    if not currentCamera then return nil, nil, nil end

    local fovEnabled = Toggles.FOVEnabled.Value
    local fovRadiusSq = Options.FOVRadius.Value * Options.FOVRadius.Value
    local visibleCheck = Toggles.VisibleCheck.Value
    
    local targetPlayers = Toggles.SilentAimEnabled.Value

    if not targetPlayers then
        return nil, nil, nil
    end

    local localChar = LocalPlayer.Character
    table.clear(filterList)
    table.clear(entitiesList)
    table.clear(potentialTargetsList)

    table.insert(filterList, currentCamera)
    if localChar then
        table.insert(filterList, localChar)
    end
    if rayExceptionFolder then
        table.insert(filterList, rayExceptionFolder)
    elseif debrisFolder then
        table.insert(filterList, debrisFolder)
    end
    sharedRayParams.FilterDescendantsInstances = filterList

    local camCFramePos = currentCamera.CFrame.Position

    for player, data in pairs(ESPCache) do
        local cached = validateCache(player, data)
        if cached and cached.Humanoid and cached.Humanoid.Health > 0 then
            if player.Team then
                local ignoredTeams = Options.IgnoredTeams.Value
                if ignoredTeams and ignoredTeams[player.Team.Name] then
                    continue
                end
            end
        
            if Toggles.InvisibleCheck.Value then
                local head = cached.Character:FindFirstChild("Head")
                if head and head.Transparency >= 0.5 then
                    continue
                end
            end
            table.insert(entitiesList, {
                character = cached.Character,
                head = cached.Character:FindFirstChild("Head"),
                hrp = cached.HRP
            })
        end
    end

    local now = os.clock()
    for i = 1, #entitiesList do
        local entity = entitiesList[i]
        local targetPartName = Options.Hitpart.Value
        local targetPart
        
        if not TargetCache[entity.character] or not entity.character.Parent then
            TargetCache[entity.character] = { part = nil, lastUpdate = 0 }
        end
        
        local cache = TargetCache[entity.character]
        if now - cache.lastUpdate >= 0.5 or not cache.part or not cache.part.Parent then
            if targetPartName == 'Random' then
                local parts = {}
                for _, v in ipairs(entity.character:GetChildren()) do
                    if v:IsA("BasePart") and v.Name ~= "HumanoidRootPart" then
                        table.insert(parts, v)
                    end
                end
                if #parts > 0 then
                    cache.part = parts[math.random(1, #parts)]
                else
                    cache.part = entity.hrp
                end
            else
                cache.part = targetPartName == 'Head' and entity.head or entity.hrp
            end
            cache.lastUpdate = now
        end
        
        targetPart = cache.part
        if not targetPart or not targetPart.Parent then continue end

        local rootScreenPos, rootOnScreen = currentCamera:WorldToViewportPoint(targetPart.Position)
        if fovEnabled and rootOnScreen then
            local rx, ry = rootScreenPos.X - mousePos.X, rootScreenPos.Y - mousePos.Y
            local rootDistSq = (rx * rx) + (ry * ry)
            if rootDistSq > (fovRadiusSq * 3) then
                continue
            end
        end

        if not skipMultipoint then
            local size = targetPart.Size * 0.8
            local cf = targetPart.CFrame
            local hx, hy, hz = size.X / 2, size.Y / 2, size.Z / 2
             
            for _, offset in ipairs(MULTIPOINT_OFFSETS) do
                local point = cf * Vector3.new(hx * offset.X, hy * offset.Y, hz * offset.Z)
                local screenPos, onScreen = currentCamera:WorldToViewportPoint(point)
                
                if onScreen then
                    local px, py = screenPos.X - mousePos.X, screenPos.Y - mousePos.Y
                    local distSq = (px * px) + (py * py)
                    
                    if not fovEnabled or distSq <= fovRadiusSq then
                        table.insert(potentialTargetsList, {
                            distanceSq = distSq,
                            pos2D = Vector2.new(screenPos.X, screenPos.Y),
                            part = targetPart,
                            hitPos = point,
                            character = entity.character
                        })
                    end
                end
            end
        else
            local point = targetPart.Position
            local screenPos, onScreen = currentCamera:WorldToViewportPoint(point)
            
            if onScreen then
                local px, py = screenPos.X - mousePos.X, screenPos.Y - mousePos.Y
                local distSq = (px * px) + (py * py)
                
                if not fovEnabled or distSq <= fovRadiusSq then
                    table.insert(potentialTargetsList, {
                        distanceSq = distSq,
                        pos2D = Vector2.new(screenPos.X, screenPos.Y),
                        part = targetPart,
                        hitPos = point,
                        character = entity.character
                    })
                end
            end
        end
    end

    table.sort(potentialTargetsList, function(a, b)
        return a.distanceSq < b.distanceSq
    end)

    for i = 1, #potentialTargetsList do
        local target = potentialTargetsList[i]
        if visibleCheck then
            local isVisible = checkVisibility(camCFramePos, target.hitPos, target.character)
            if isVisible then
                return target.pos2D, target.part, target.hitPos
            end
        else
            return target.pos2D, target.part, target.hitPos
        end
    end

    return nil, nil, nil
end

local fullbrightConnection
local function updateFullbright()
    if Toggles.Fullbright.Value then
        if Lighting.Brightness ~= 2 then Lighting.Brightness = 2 end
        if Lighting.ClockTime ~= 14 then Lighting.ClockTime = 14 end
        if Lighting.FogEnd ~= 100000 then Lighting.FogEnd = 100000 end
        if Lighting.GlobalShadows ~= false then Lighting.GlobalShadows = false end
        if Lighting.OutdoorAmbient ~= Color3.fromRGB(128, 128, 128) then Lighting.OutdoorAmbient = Color3.fromRGB(128, 128, 128) end
    end
end

Toggles.Fullbright:OnChanged(function()
    if Toggles.Fullbright.Value then
        OriginalLighting.Brightness = Lighting.Brightness
        OriginalLighting.ClockTime = Lighting.ClockTime
        OriginalLighting.FogEnd = Lighting.FogEnd
        OriginalLighting.GlobalShadows = Lighting.GlobalShadows
        OriginalLighting.OutdoorAmbient = Lighting.OutdoorAmbient
        updateFullbright()
        fullbrightConnection = Lighting.Changed:Connect(updateFullbright)
    else
        if fullbrightConnection then
            fullbrightConnection:Disconnect()
            fullbrightConnection = nil
        end
        if OriginalLighting.Brightness then
            Lighting.Brightness = OriginalLighting.Brightness
            Lighting.ClockTime = OriginalLighting.ClockTime
            Lighting.FogEnd = OriginalLighting.FogEnd
            Lighting.GlobalShadows = OriginalLighting.GlobalShadows
            Lighting.OutdoorAmbient = OriginalLighting.OutdoorAmbient
        end
    end
end)

local function updateVisualsForCache(cacheTable, currentCamera, camPos)
    local boxEnabled = Toggles.ESPBox.Value
    local skeletonEnabled = Toggles.ESPSkeleton.Value
    local nameEnabled = Toggles.ESPName.Value
    local distanceEnabled = Toggles.ESPDistance.Value
    local healthEnabled = Toggles.ESPHealth.Value
    local healthTextEnabled = Toggles.ESPHealthText.Value
    
    local boxColorVal = Options.BoxColor.Value
    local nameColorVal = Options.NameColor.Value
    local skelColorVal = Options.SkeletonColor.Value
    local boxTypeVal = Options.ESPBoxType.Value

    local teamColorEnabled = Toggles.ESPTeamColor.Value
    local toolEnabled = Toggles.ESPTool.Value

    local needsBox = boxEnabled or nameEnabled or distanceEnabled or healthEnabled or toolEnabled or healthTextEnabled

    for entity, data in pairs(cacheTable) do
        local cached = validateCache(entity, data)
        if cached and cached.Humanoid.Health > 0 then
            local hrp = cached.HRP
            local humanoid = cached.Humanoid
            local character = cached.Character
            local distanceToCam = (camPos - hrp.Position).Magnitude
            
            local hasTeamColor = false
            local espColor = Color3.new(1, 1, 1)
            
            if teamColorEnabled and entity.Team then
                espColor = entity.TeamColor.Color
                hasTeamColor = true
            end

            local currentBoxColor = hasTeamColor and espColor or (boxColorVal or espColor)
            local currentNameColor = hasTeamColor and espColor or (nameColorVal or espColor)
            local currentSkeletonColor = hasTeamColor and espColor or (skelColorVal or espColor)

            local topPos, bottomPos, onScreenTop, onScreenBottom
            local isBoxVisible = false
            
            if needsBox then
                topPos, onScreenTop = currentCamera:WorldToViewportPoint(hrp.Position + BOX_TOP_OFFSET)
                bottomPos, onScreenBottom = currentCamera:WorldToViewportPoint(hrp.Position - BOX_BOTTOM_OFFSET)
                isBoxVisible = onScreenTop or onScreenBottom
            end

            if isBoxVisible then
                local boxHeight = math.abs(topPos.Y - bottomPos.Y)
                local boxWidth = boxHeight * 0.625
                local boxX = topPos.X - (boxWidth / 2)
                local boxY = topPos.Y

                if boxEnabled then
                    if boxTypeVal == 'Corner' then
                        setDrawingProp(data.Box, "Visible", false)
                        local lineW = boxWidth / 3
                        local lineH = boxHeight / 4
                        
                        data.CornerBox[1].From = Vector2.new(boxX, boxY)
                        data.CornerBox[1].To = Vector2.new(boxX + lineW, boxY)
                        data.CornerBox[2].From = Vector2.new(boxX, boxY)
                        data.CornerBox[2].To = Vector2.new(boxX, boxY + lineH)
                        data.CornerBox[3].From = Vector2.new(boxX + boxWidth, boxY)
                        data.CornerBox[3].To = Vector2.new(boxX + boxWidth - lineW, boxY)
                        data.CornerBox[4].From = Vector2.new(boxX + boxWidth, boxY)
                        data.CornerBox[4].To = Vector2.new(boxX + boxWidth, boxY + lineH)
                        data.CornerBox[5].From = Vector2.new(boxX, boxY + boxHeight)
                        data.CornerBox[5].To = Vector2.new(boxX + lineW, boxY + boxHeight)
                        data.CornerBox[6].From = Vector2.new(boxX, boxY + boxHeight)
                        data.CornerBox[6].To = Vector2.new(boxX, boxY + boxHeight - lineH)
                        data.CornerBox[7].From = Vector2.new(boxX + boxWidth, boxY + boxHeight)
                        data.CornerBox[7].To = Vector2.new(boxX + boxWidth - lineW, boxY + boxHeight)
                        data.CornerBox[8].From = Vector2.new(boxX + boxWidth, boxY + boxHeight)
                        data.CornerBox[8].To = Vector2.new(boxX + boxWidth, boxY + boxHeight - lineH)
                        
                        for i = 1, 8 do
                            setDrawingProp(data.CornerBox[i], "Color", currentBoxColor)
                            setDrawingProp(data.CornerBox[i], "Visible", true)
                        end
                    else
                        for i = 1, 8 do setDrawingProp(data.CornerBox[i], "Visible", false) end
                        setDrawingProp(data.Box, "Position", Vector2.new(boxX, boxY))
                        setDrawingProp(data.Box, "Size", Vector2.new(boxWidth, boxHeight))
                        setDrawingProp(data.Box, "Color", currentBoxColor)
                        setDrawingProp(data.Box, "Visible", true)
                    end
                else
                    setDrawingProp(data.Box, "Visible", false)
                    for i = 1, 8 do setDrawingProp(data.CornerBox[i], "Visible", false) end
                end

                if nameEnabled then
                    setDrawingProp(data.NameTag, "Text", character.Name)
                    setDrawingProp(data.NameTag, "Position", Vector2.new(topPos.X, boxY - 16))
                    setDrawingProp(data.NameTag, "Color", currentNameColor)
                    setDrawingProp(data.NameTag, "Visible", true)
                else
                    setDrawingProp(data.NameTag, "Visible", false)
                end

                local yOffset = bottomPos.Y + 2
                
                if distanceEnabled then
                    setDrawingProp(data.DistanceTag, "Text", tostring(math.floor(distanceToCam)) .. "m")
                    setDrawingProp(data.DistanceTag, "Position", Vector2.new(topPos.X, yOffset))
                    setDrawingProp(data.DistanceTag, "Color", currentNameColor)
                    setDrawingProp(data.DistanceTag, "Visible", true)
                    yOffset = yOffset + 14
                else
                    setDrawingProp(data.DistanceTag, "Visible", false)
                end

                if toolEnabled then
                    local tool = character:FindFirstChildOfClass("Tool")
                    setDrawingProp(data.ToolTag, "Text", tool and tool.Name or "None")
                    setDrawingProp(data.ToolTag, "Position", Vector2.new(topPos.X, yOffset))
                    setDrawingProp(data.ToolTag, "Color", currentNameColor)
                    setDrawingProp(data.ToolTag, "Visible", true)
                else
                    setDrawingProp(data.ToolTag, "Visible", false)
                end

                local healthPercent = math.clamp(humanoid.Health / (humanoid.MaxHealth > 0 and humanoid.MaxHealth or 100), 0, 1)
                local barWidth = 3
                local barOffset = 5
                local barX = boxX - barOffset - barWidth
                local healthHeight = boxHeight * healthPercent
                local healthColor = Color3.fromRGB(255, 0, 0):Lerp(Color3.fromRGB(0, 255, 0), healthPercent)

                if healthEnabled then
                    setDrawingProp(data.HealthBarBg, "Position", Vector2.new(barX, boxY))
                    setDrawingProp(data.HealthBarBg, "Size", Vector2.new(barWidth, boxHeight))
                    setDrawingProp(data.HealthBarBg, "Visible", true)
                    
                    setDrawingProp(data.HealthBar, "Position", Vector2.new(barX, boxY + (boxHeight - healthHeight)))
                    setDrawingProp(data.HealthBar, "Size", Vector2.new(barWidth, healthHeight))
                    setDrawingProp(data.HealthBar, "Color", healthColor)
                    setDrawingProp(data.HealthBar, "Visible", true)
                else
                    setDrawingProp(data.HealthBarBg, "Visible", false)
                    setDrawingProp(data.HealthBar, "Visible", false)
                end

                if healthTextEnabled then
                    setDrawingProp(data.HealthTextTag, "Text", tostring(math.floor(humanoid.Health)) .. " HP")
                    setDrawingProp(data.HealthTextTag, "Position", Vector2.new(barX - 18, boxY + (boxHeight - healthHeight) - 6))
                    setDrawingProp(data.HealthTextTag, "Color", healthColor)
                    setDrawingProp(data.HealthTextTag, "Visible", true)
                else
                    setDrawingProp(data.HealthTextTag, "Visible", false)
                end

            else
                setDrawingProp(data.Box, "Visible", false)
                for i = 1, 8 do setDrawingProp(data.CornerBox[i], "Visible", false) end
                setDrawingProp(data.HealthBarBg, "Visible", false)
                setDrawingProp(data.HealthBar, "Visible", false)
                setDrawingProp(data.NameTag, "Visible", false)
                setDrawingProp(data.DistanceTag, "Visible", false)
                setDrawingProp(data.HealthTextTag, "Visible", false)
                setDrawingProp(data.ToolTag, "Visible", false)
            end

            if skeletonEnabled and distanceToCam <= 1000 then
                local currentBones = cached.BoneParts
                for i, line in ipairs(data.Skeleton) do
                    local parts = currentBones[i]
                    if parts then
                        local partA, partB = parts[1], parts[2]
                        if partA and partB and partA.Parent and partB.Parent then
                            local posA, onScreenA = currentCamera:WorldToViewportPoint(partA.Position)
                            local posB, onScreenB = currentCamera:WorldToViewportPoint(partB.Position)
                            
                            if onScreenA and onScreenB then
                                line.From = Vector2.new(posA.X, posA.Y)
                                line.To = Vector2.new(posB.X, posB.Y)
                                setDrawingProp(line, "Color", currentSkeletonColor)
                                setDrawingProp(line, "Visible", true)
                            else
                                setDrawingProp(line, "Visible", false)
                            end
                        else
                            setDrawingProp(line, "Visible", false)
                        end
                    else
                        setDrawingProp(line, "Visible", false)
                    end
                end
            else
                for i = 1, 14 do setDrawingProp(data.Skeleton[i], "Visible", false) end
            end
        else
            hideVisuals(data)
        end
    end
end

local espWasEnabled = false
local silentAimTarget = { part = nil, hitPos = nil }

table.insert(Connections, RunService.RenderStepped:Connect(function()
    local currentCamera = Workspace.CurrentCamera
    if not currentCamera then return end

    local mousePos = UserInputService:GetMouseLocation()
    
    if Toggles.SilentAimEnabled.Value then
        local _, hitPart, hitPos = getClosestCharacterToMouse(mousePos, currentCamera, false)
        silentAimTarget.part = hitPart
        silentAimTarget.hitPos = hitPos
    else
        silentAimTarget.part = nil
        silentAimTarget.hitPos = nil
    end

    local fovEnabled = Toggles.FOVEnabled.Value
    local tracerEnabled = Toggles.TracerEnabled.Value

    if fovEnabled then
        local outlineEnabled = Toggles.FOVOutline.Value
        local filledEnabled = Toggles.FOVFilled.Value
        local fovRadius = Options.FOVRadius.Value
        local fovNumSides = Options.FOVNumSides.Value

        setDrawingProp(FOVCircle, "Visible", outlineEnabled)
        setDrawingProp(FOVFilledCircle, "Visible", filledEnabled)

        if outlineEnabled then
            setDrawingProp(FOVCircle, "Position", mousePos)
            setDrawingProp(FOVCircle, "Radius", fovRadius)
            setDrawingProp(FOVCircle, "Thickness", Options.FOVThickness.Value)
            setDrawingProp(FOVCircle, "NumSides", fovNumSides)
            setDrawingProp(FOVCircle, "Color", Options.FOVOutlineColor.Value)
        end

        if filledEnabled then
            setDrawingProp(FOVFilledCircle, "Position", mousePos)
            setDrawingProp(FOVFilledCircle, "Radius", fovRadius)
            setDrawingProp(FOVFilledCircle, "NumSides", fovNumSides)
            setDrawingProp(FOVFilledCircle, "Color", Options.FOVFilledColor.Value)
            setDrawingProp(FOVFilledCircle, "Transparency", Options.FOVFilledTransparency.Value)
        end
    else
        setDrawingProp(FOVCircle, "Visible", false)
        setDrawingProp(FOVFilledCircle, "Visible", false)
    end

    if tracerEnabled then
        local targetPos = getClosestCharacterToMouse(mousePos, currentCamera, true)
        if targetPos then
            setDrawingProp(TracerLine, "Visible", true)
            setDrawingProp(TracerLine, "From", mousePos)
            setDrawingProp(TracerLine, "To", targetPos)
            setDrawingProp(TracerLine, "Color", Options.TracerColor.Value)
            setDrawingProp(TracerLine, "Thickness", Options.TracerThickness.Value)
        else
            setDrawingProp(TracerLine, "Visible", false)
        end
    else
        setDrawingProp(TracerLine, "Visible", false)
    end

    local camPos = currentCamera.CFrame.Position
    
    if Toggles.ESPEnabled.Value then
        updateVisualsForCache(ESPCache, currentCamera, camPos)
        espWasEnabled = true
    elseif espWasEnabled then
        for _, data in pairs(ESPCache) do hideVisuals(data) end
        espWasEnabled = false
    end
end))

local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
    local Method = tostring(getnamecallmethod())
    
    if checkcaller() or (Library and Library.Unloaded) then return oldNamecall(self, ...) end

    if Method == "Raycast" and self == Workspace and Options.SilentAimMethod.Value == 'Raycast' then
        if Toggles.SilentAimEnabled.Value then
            local cachedPart = silentAimTarget.part
            local cachedHitPos = silentAimTarget.hitPos
            
            local calling_script = getcallingscript and getcallingscript()
            if calling_script then
                local scriptName = calling_script.Name
                if scriptName == "CameraModule" or scriptName == "Poppercam" or scriptName == "ZoomController" or scriptName == "TransparencyController" then
                    return oldNamecall(self, ...)
                end
            end

            local args = {...}
            if type(args[1]) == "Vector3" and type(args[2]) == "Vector3" then
                if cachedPart and cachedHitPos then
                    local chance = Options.Hitchance.Value
                    if CalculateChance(chance) then
                        local hitPos = cachedHitPos
                        if Toggles.PredictionEnabled.Value then
                            hitPos = hitPos + (cachedPart.Velocity * Options.PredictionAmount.Value)
                        end
                        args[2] = (hitPos - args[1]).Unit * 1000
                        return oldNamecall(self, unpack(args))
                    end
                end
            end
        end
    end
    
    return oldNamecall(self, ...)
end))

local oldIndex = nil 
oldIndex = hookmetamethod(game, "__index", newcclosure(function(self, Index)
    if checkcaller() or (Library and Library.Unloaded) then return oldIndex(self, Index) end

    if self == PlayerMouse and Options.SilentAimMethod.Value == 'Mouse.Hit' then
        local cachedPart = silentAimTarget.part
        local cachedHitPos = silentAimTarget.hitPos
        
        if Toggles.SilentAimEnabled.Value and cachedPart and cachedHitPos then
            local chance = Options.Hitchance.Value
            if CalculateChance(chance) then
                local hitPos = cachedHitPos
                if Toggles.PredictionEnabled.Value then
                    hitPos = hitPos + (cachedPart.Velocity * Options.PredictionAmount.Value)
                end
                
                if Index == "Target" or Index == "target" then 
                    return cachedPart
                elseif Index == "Hit" or Index == "hit" then 
                    return CFrame.new(hitPos)
                end
            end
        end
    end

    return oldIndex(self, Index)
end))

SaveManager:LoadAutoloadConfig()

Library:OnUnload(function()
    for _, conn in ipairs(Connections) do
        conn:Disconnect()
    end
    
    if FOVCircle then FOVCircle:Remove() end
    if FOVFilledCircle then FOVFilledCircle:Remove() end
    if TracerLine then TracerLine:Remove() end
    
    table.clear(drawingPropCache)
    
    if fullbrightConnection then
        fullbrightConnection:Disconnect()
    end
    
    for player, _ in pairs(ESPCache) do
        removeESPData(ESPCache, player)
    end
    
    if OriginalLighting.Brightness then
        Lighting.Brightness = OriginalLighting.Brightness
        Lighting.ClockTime = OriginalLighting.ClockTime
        Lighting.FogEnd = OriginalLighting.FogEnd
        Lighting.GlobalShadows = OriginalLighting.GlobalShadows
        Lighting.OutdoorAmbient = OriginalLighting.OutdoorAmbient
    end
    
    Library.Unloaded = true
end)
