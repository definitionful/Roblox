Options.WalkSpeedValue:OnChanged(function()
    local stepped = math.floor(Options.WalkSpeedValue.Value * 2 + 0.5) / 2
    if Options.WalkSpeedValue.Value ~= stepped then
        Options.WalkSpeedValue:SetValue(stepped)
    end
end)

Options.SprintSpeedValue:OnChanged(function()
    local stepped = math.floor(Options.SprintSpeedValue.Value * 2 + 0.5) / 2
    if Options.SprintSpeedValue.Value ~= stepped then
        Options.SprintSpeedValue:SetValue(stepped)
    end
end)

Toggles.CustomWalkSpeed:OnChanged(function()
    if not Toggles.CustomWalkSpeed.Value then
        local pc = LocalPlayer:FindFirstChild("PlayerConfig")
        local mv = pc and pc:FindFirstChild("MovementVariables")
        if mv then
            mv:SetAttribute("WalkSpeed", defaultWalkSpeed)
        end
    end
end)

Toggles.CustomSprintSpeed:OnChanged(function()
    if not Toggles.CustomSprintSpeed.Value then
        local pc = LocalPlayer:FindFirstChild("PlayerConfig")
        local mv = pc and pc:FindFirstChild("MovementVariables")
        if mv then
            mv:SetAttribute("SprintSpeed", defaultSprintSpeed)
        end
    end
end)

