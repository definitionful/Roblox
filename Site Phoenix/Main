local defaultWalkSpeed = 8
local defaultSprintSpeed = 24
if LocalPlayer then
    local playerConfig = LocalPlayer:WaitForChild("PlayerConfig", 5)
    if playerConfig then
        local movementVariables = playerConfig:WaitForChild("MovementVariables", 5)
        if movementVariables then
            defaultWalkSpeed = movementVariables:GetAttribute("WalkSpeed") or defaultWalkSpeed
            defaultSprintSpeed = movementVariables:GetAttribute("SprintSpeed") or defaultSprintSpeed
        end
    end
end

