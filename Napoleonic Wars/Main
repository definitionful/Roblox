    local line = Drawing.new("Line")
    setDrawingProp(line, "Thickness", 1)
    setDrawingProp(line, "Transparency", 1)
    setDrawingProp(line, "Visible", false)
    table.insert(MeleeRangeLines, line)
end

local MeleeTargetTracer = Drawing.new("Line")
setDrawingProp(MeleeTargetTracer, "Thickness", 1)
setDrawingProp(MeleeTargetTracer, "Transparency", 1)
setDrawingProp(MeleeTargetTracer, "Visible", false)

local MULTIPOINT_OFFSETS = {
    Vector3.new(0, 0, 0),
    Vector3.new(1, 1, 1), Vector3.new(-1, 1, 1), Vector3.new(1, -1, 1), Vector3.new(-1, -1, 1),
    Vector3.new(1, 1, -1), Vector3.new(-1, 1, -1), Vector3.new(1, -1, -1), Vector3.new(-1, -1, -1),
    Vector3.new(1, 0, 0), Vector3.new(-1, 0, 0), Vector3.new(0, 1, 0), Vector3.new(0, -1, 0)
}

local sharedRayParams = RaycastParams.new()
sharedRayParams.FilterType = Enum.RaycastFilterType.Exclude
local sharedVisibilityParams = RaycastParams.new()
sharedVisibilityParams.FilterType = Enum.RaycastFilterType.Exclude

local filterList = {}
local dynamicFilterList = {}
local entitiesList = {}
local potentialTargetsList = {}

