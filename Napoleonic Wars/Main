getgenv()._UnloadPreviousInstance = function()
    if Library and not Library.Unloaded then
        Library:Unload()
    end
end

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Teams = game:GetService("Teams")
local Workspace = game:GetService("Workspace")

local LocalPlayer = Players.LocalPlayer

local ProjectileArray = nil
for _, inst in ipairs(getinstances()) do
    if inst.ClassName == "ModuleScript" and inst.Name == "UtilityIncidentsClient" then
        local success, util = pcall(require, inst)
        if success and type(util) == "table" then
            for key, val in pairs(util) do
                if type(val) == "function" then
                    hookfunction(util[key], function() end)
                end
            end
        end
    end
end

local function locateProjectileArray()
    for _, item in ipairs(getgc(true)) do
        if type(item) == "table" and rawget(item, 1) and type(rawget(item, 1)) == "table" then
            local proj = rawget(item, 1)
            if type(rawget(proj, "simulate")) == "function" and type(rawget(proj, "destroy")) == "function" and rawget(proj, "velocity") then
                ProjectileArray = item
                return true
            end
        end
    end
    return false
end

local function findModuleBySignature(signatures)
    if getgc then
        for _, item in ipairs(getgc(true)) do
            if type(item) == "table" then
                local match = true
                for _, sig in ipairs(signatures) do
                    if type(rawget(item, sig)) ~= "function" then
                        match = false
                        break
                    end
                end
                if match then return item end
            end
        end
    end
    if getloadedmodules then
        for _, mod in ipairs(getloadedmodules()) do
            if typeof(mod) == "Instance" and mod:IsA("ModuleScript") then
                local ok, res = pcall(require, mod)
                if ok and type(res) == "table" then
                    local match = true
                    for _, sig in ipairs(signatures) do
                        if type(rawget(res, sig)) ~= "function" then
                            match = false
                            break
                        end
                    end
                    if match then return res end
                end
            end
        end
    end
    return nil
end

local WeaponsDamageClient = findModuleBySignature({"dealMelee", "dealMeleeToHorse", "getHorseByModelPart"})
local WeaponsTargetsClient = findModuleBySignature({"hitTarget"})
local cachedTargets = {}
local Connections = {}

for _, obj in ipairs(Workspace:GetDescendants()) do
    if obj.Name == "TargetModel" and obj:IsA("Model") then
        cachedTargets[obj] = true
    end
end

table.insert(Connections, Workspace.DescendantAdded:Connect(function(obj)
    if obj.Name == "TargetModel" and obj:IsA("Model") then
        cachedTargets[obj] = true
    end
end))

table.insert(Connections, Workspace.DescendantRemoving:Connect(function(obj)
    if cachedTargets[obj] then
        cachedTargets[obj] = nil
    end
end))

local drawingPropCache = {}

local function setDrawingProp(drawing, prop, value)
    if not drawingPropCache[drawing] then drawingPropCache[drawing] = {} end
    if drawingPropCache[drawing][prop] ~= value then
        drawingPropCache[drawing][prop] = value
        drawing[prop] = value
    end
end

local FOVCircle = Drawing.new("Circle")
setDrawingProp(FOVCircle, "Visible", false)
setDrawingProp(FOVCircle, "Thickness", 1)
setDrawingProp(FOVCircle, "NumSides", 32)
setDrawingProp(FOVCircle, "Filled", false)
setDrawingProp(FOVCircle, "Transparency", 1)
setDrawingProp(FOVCircle, "ZIndex", 2)

local FOVFilledCircle = Drawing.new("Circle")
setDrawingProp(FOVFilledCircle, "Visible", false)
setDrawingProp(FOVFilledCircle, "Thickness", 1)
setDrawingProp(FOVFilledCircle, "NumSides", 32)
setDrawingProp(FOVFilledCircle, "Filled", true)
setDrawingProp(FOVFilledCircle, "Transparency", 1)
setDrawingProp(FOVFilledCircle, "ZIndex", 1)

local TracerLine = Drawing.new("Line")
setDrawingProp(TracerLine, "Visible", false)
setDrawingProp(TracerLine, "Thickness", 1)
setDrawingProp(TracerLine, "ZIndex", 3)

local MeleeRangeLines = {}
