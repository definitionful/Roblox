if targetModule then
    local origGetMisfired = targetModule.getMisfired
    targetModule.getMisfired = function(...)
        if Toggles.NoMisfire and Toggles.NoMisfire.Value then
            return false, false
        end
        if origGetMisfired then return origGetMisfired(...) end
    end
end

local AIM_SPEED = 0.15 
for _, obj in ipairs(getgc(true)) do
    if type(obj) == "table" then
        if rawget(obj, "ClassName") == "FireActionClient" and rawget(obj, "UpdateReticle") then
            local originalUpdateReticle = obj.UpdateReticle
            obj.UpdateReticle = function(self, progress, ...)
                if Toggles.InstantAim and Toggles.InstantAim.Value then
                    if self.aiming then
                        self.customAimProgress = math.min(1, (self.customAimProgress or 0) + AIM_SPEED)
                        local smoothProgress = math.sin(self.customAimProgress * (math.pi / 2))
                        self.aimProgress = smoothProgress
                        self.realAimTime = math.max(self.realAimTime or 0, smoothProgress)
                        return originalUpdateReticle(self, smoothProgress, ...)
                    else
                        self.customAimProgress = 0
                        return originalUpdateReticle(self, progress, ...)
                    end
                end
                return originalUpdateReticle(self, progress, ...)
            end
        elseif rawget(obj, "shakeFiredShot") then
            local originalShake = obj.shakeFiredShot
            obj.shakeFiredShot = function(...)
                if Toggles.NoRecoil and Toggles.NoRecoil.Value then return end
                return originalShake(...)
            end
        elseif rawget(obj, "fireBProjectile") then
            local originalFireBProjectile = obj.fireBProjectile
            obj.fireBProjectile = function(velocity, position, weaponValue, spread, selfObj, ...)
                if Toggles.NoSpread and Toggles.NoSpread.Value and selfObj and type(selfObj) == "table" and selfObj.muzzleAttachment then
                    local cframe = selfObj.muzzleAttachment.WorldCFrame
                    if selfObj.muzzleProjectileOffset then
                        cframe = cframe * selfObj.muzzleProjectileOffset
                    end
                    local lookVector = cframe.LookVector
                    local straightVelocity = lookVector * velocity.Magnitude
                    local exactPosition = cframe.Position + lookVector
                    return originalFireBProjectile(straightVelocity, exactPosition, weaponValue, 0, selfObj, ...)
                end
                return originalFireBProjectile(velocity, position, weaponValue, spread, selfObj, ...)
            end
        end
    end
end

local function checkVisibility(startPos, endPos, character)
    local direction = endPos - startPos
    table.clear(dynamicFilterList)
    for i = 1, #filterList do dynamicFilterList[i] = filterList[i] end
    for i = 1, 5 do
        sharedVisibilityParams.FilterDescendantsInstances = dynamicFilterList
        local result = Workspace:Raycast(startPos, direction, sharedVisibilityParams)
        if not result then return true end
        if character and result.Instance:IsDescendantOf(character) then return true end
        if result.Instance.Transparency > 0.5 or not result.Instance.CanCollide then
            table.insert(dynamicFilterList, result.Instance)
        else
            return false
        end
    end
    return false
end

local function getClosestCharacterToMouse(mousePos, currentCamera)
    if not currentCamera then return nil, nil, nil, nil end
    local fovEnabled = Toggles.FOVEnabled.Value
    local fovRadiusSq = Options.FOVRadius.Value * Options.FOVRadius.Value
    local maxDistance = Options.SilentAimMaxDist.Value

    local localChar = LocalPlayer.Character
    table.clear(filterList)
    table.clear(entitiesList)
    table.clear(potentialTargetsList)

    table.insert(filterList, currentCamera)
    if localChar then table.insert(filterList, localChar) end
    if rayExceptionFolder then
        table.insert(filterList, rayExceptionFolder)
    elseif debrisFolder then
        table.insert(filterList, debrisFolder)
    end
    
    local camCFramePos = currentCamera.CFrame.Position

    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        if LocalPlayer.Team and player.Team == LocalPlayer.Team then continue end
        
        local character = player.Character
        if not character then continue end
        
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        local hrp = character:FindFirstChild("HumanoidRootPart") or character.PrimaryPart or character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso")
        
        if not humanoid or not hrp or humanoid.Health <= 0 then continue end

        local priority = 3
        if humanoid.MaxHealth > 100 then
            priority = priority - 5
        end
        if player:GetAttribute("FlagBearer") == true then
            if Toggles.PrioritizeFlagBearers and Toggles.PrioritizeFlagBearers.Value then
                priority = priority + 10
            else
                priority = priority - 5
            end
        end
        
        table.insert(entitiesList, {character = character, hrp = hrp, priority = priority})
    end

    for obj in pairs(cachedTargets) do
        if obj.Parent then
            local primary = obj.PrimaryPart
            if not primary then
                for _, child in ipairs(obj:GetDescendants()) do
                    if child:IsA("BasePart") then
                        primary = child
                        break
                    end
                end
            end
            if primary then
                table.insert(entitiesList, {character = obj, hrp = primary, priority = 1})
            end
        else
            cachedTargets[obj] = nil
        end
    end

    for i = 1, #entitiesList do
        local entity = entitiesList[i]
        local targetPart = entity.hrp
        if not targetPart or not targetPart.Parent then continue end

        local point = targetPart.Position
        if (point - camCFramePos).Magnitude > maxDistance then continue end

        local screenPos, onScreen = currentCamera:WorldToViewportPoint(point)
        if not onScreen then continue end

        local px, py = screenPos.X - mousePos.X, screenPos.Y - mousePos.Y
        local distSq = (px * px) + (py * py)

        if fovEnabled and distSq > fovRadiusSq then continue end

        table.insert(potentialTargetsList, {
            distanceSq = distSq, pos2D = Vector2.new(screenPos.X, screenPos.Y),
            part = targetPart, hitPos = point, character = entity.character, priority = entity.priority
        })
    end

    table.sort(potentialTargetsList, function(a, b)
        if a.priority ~= b.priority then
            return a.priority > b.priority
        end
        return a.distanceSq < b.distanceSq
    end)

    for i = 1, #potentialTargetsList do
        local target = potentialTargetsList[i]
        if not Toggles.VisibleCheck.Value or checkVisibility(camCFramePos, target.hitPos, target.character) then
            return target.pos2D, target.part, target.hitPos, target.character
        end
    end
    return nil, nil, nil, nil
end

local silentAimTarget = { part = nil, hitPos = nil, character = nil, pos2D = nil }
local currentMeleeTargetRoot = nil

table.insert(Connections, RunService.RenderStepped:Connect(function()
    local currentCamera = Workspace.CurrentCamera
    if not currentCamera then return end

    local mousePos = UserInputService:GetMouseLocation()
    local silentAimEnabled = Toggles.SilentAimEnabled and Toggles.SilentAimEnabled.Value
    local tracerEnabled = Toggles.TracerEnabled and Toggles.TracerEnabled.Value
    local fovEnabled = Toggles.FOVEnabled and Toggles.FOVEnabled.Value
    local requireTargeting = silentAimEnabled or tracerEnabled

    if requireTargeting then
        local now = os.clock()
        if now - lastTargetUpdateTime >= TARGET_UPDATE_INTERVAL then
            lastTargetUpdateTime = now
            local keepTarget = false
            
            if Toggles.StickyAim and Toggles.StickyAim.Value and silentAimTarget.character then
                local char = silentAimTarget.character
                local hrp = silentAimTarget.part
                local hum = char:FindFirstChildOfClass("Humanoid")
                
                if char.Parent and hrp and hrp.Parent and (not hum or hum.Health > 0) then
                    local point = hrp.Position
                    local camPos = currentCamera.CFrame.Position
                    if (point - camPos).Magnitude <= Options.SilentAimMaxDist.Value then
                        local screenPos, onScreen = currentCamera:WorldToViewportPoint(point)
                        if onScreen then
                            local px, py = screenPos.X - mousePos.X, screenPos.Y - mousePos.Y
                            local distSq = (px * px) + (py * py)
                            local fovRadiusSq = Options.FOVRadius.Value * Options.FOVRadius.Value
                            
                            if (not fovEnabled) or (distSq <= fovRadiusSq) then
                                if not Toggles.VisibleCheck.Value or checkVisibility(camPos, point, char) then
                                    keepTarget = true
                                    silentAimTarget.hitPos = point
                                    silentAimTarget.pos2D = Vector2.new(screenPos.X, screenPos.Y)
                                end
                            end
                        end
                    end
                end
            end

            if not keepTarget then
                local pos2D, hitPart, hitPos, hitChar = getClosestCharacterToMouse(mousePos, currentCamera)
                silentAimTarget.part = hitPart
                silentAimTarget.hitPos = hitPos
                silentAimTarget.character = hitChar
                silentAimTarget.pos2D = pos2D
            end
        end
    else
        silentAimTarget.part = nil
        silentAimTarget.hitPos = nil
        silentAimTarget.character = nil
        silentAimTarget.pos2D = nil
    end

    if fovEnabled then
        local outlineEnabled = Toggles.FOVOutline.Value
        local filledEnabled = Toggles.FOVFilled.Value
        local fovRadius = Options.FOVRadius.Value
        local fovNumSides = Options.FOVNumSides.Value
        setDrawingProp(FOVCircle, "Visible", outlineEnabled)
        setDrawingProp(FOVFilledCircle, "Visible", filledEnabled)
        if outlineEnabled then
            setDrawingProp(FOVCircle, "Position", mousePos)
            setDrawingProp(FOVCircle, "Radius", fovRadius)
            setDrawingProp(FOVCircle, "Thickness", Options.FOVThickness.Value)
            setDrawingProp(FOVCircle, "NumSides", fovNumSides)
            setDrawingProp(FOVCircle, "Color", Options.FOVOutlineColor.Value)
        end
        if filledEnabled then
            setDrawingProp(FOVFilledCircle, "Position", mousePos)
            setDrawingProp(FOVFilledCircle, "Radius", fovRadius)
            setDrawingProp(FOVFilledCircle, "NumSides", fovNumSides)
            setDrawingProp(FOVFilledCircle, "Color", Options.FOVFilledColor.Value)
            setDrawingProp(FOVFilledCircle, "Transparency", Options.FOVFilledTransparency.Value)
        end
    else
        setDrawingProp(FOVCircle, "Visible", false)
        setDrawingProp(FOVFilledCircle, "Visible", false)
    end

    if tracerEnabled and silentAimTarget.pos2D then
        setDrawingProp(TracerLine, "Visible", true)
        setDrawingProp(TracerLine, "From", mousePos)
        setDrawingProp(TracerLine, "To", silentAimTarget.pos2D)
        setDrawingProp(TracerLine, "Color", Options.TracerColor.Value)
        setDrawingProp(TracerLine, "Thickness", Options.TracerThickness.Value)
    else
        setDrawingProp(TracerLine, "Visible", false)
    end

    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    
    if Toggles.MeleeAuraEnable and Toggles.MeleeAuraEnable.Value and Toggles.MeleeAuraCircle and Toggles.MeleeAuraCircle.Value and root then
        local range = Options.MeleeAuraRange.Value
        local rootPos = root.Position - Vector3.new(0, 3, 0)
        local angle = 6.283185307179586 / 30
        
        for i = 1, 30 do
            local currentAngle = angle * i
            local point3d = rootPos + Vector3.new(math.cos(currentAngle) * range, 0, math.sin(currentAngle) * range)
            local point2d, onScreen = currentCamera:WorldToViewportPoint(point3d)
            if not meleeAuraPoints[i] then meleeAuraPoints[i] = {} end
            meleeAuraPoints[i].pos = Vector2.new(point2d.X, point2d.Y)
            meleeAuraPoints[i].onScreen = onScreen
        end
        
        for i = 1, 30 do
            local p1 = meleeAuraPoints[i]
            local p2 = meleeAuraPoints[i == 30 and 1 or i + 1]
            local line = MeleeRangeLines[i]
            if p1.onScreen or p2.onScreen then
                setDrawingProp(line, "From", p1.pos)
                setDrawingProp(line, "To", p2.pos)
                setDrawingProp(line, "Color", Options.RangeCircleColor.Value)
                setDrawingProp(line, "Visible", true)
            else
                setDrawingProp(line, "Visible", false)
            end
        end
    else
        for i = 1, 30 do setDrawingProp(MeleeRangeLines[i], "Visible", false) end
    end
    
    if Toggles.MeleeAuraEnable and Toggles.MeleeAuraEnable.Value and Toggles.MeleeAuraTracer and Toggles.MeleeAuraTracer.Value and root and currentMeleeTargetRoot and currentMeleeTargetRoot.Parent then
        local rootPos, rootOnScreen = currentCamera:WorldToViewportPoint(root.Position)
        local targetPos, targetOnScreen = currentCamera:WorldToViewportPoint(currentMeleeTargetRoot.Position)
        if rootOnScreen or targetOnScreen then
            setDrawingProp(MeleeTargetTracer, "From", Vector2.new(rootPos.X, rootPos.Y))
            setDrawingProp(MeleeTargetTracer, "To", Vector2.new(targetPos.X, targetPos.Y))
            setDrawingProp(MeleeTargetTracer, "Color", Options.MeleeTracerColor.Value)
            setDrawingProp(MeleeTargetTracer, "Visible", true)
        else
            setDrawingProp(MeleeTargetTracer, "Visible", false)
        end
    else
        setDrawingProp(MeleeTargetTracer, "Visible", false)
    end
end))

table.insert(Connections, RunService.Heartbeat:Connect(function(deltaTime)
    if not ProjectileArray then 
        local now = os.clock()
        if now - lastArraySearch > 1 then
            lastArraySearch = now
            locateProjectileArray()
        end
        return 
    end
    
    if not Toggles.SilentAimEnabled or not Toggles.SilentAimEnabled.Value then return end
    local targetPart = silentAimTarget.part
    if not targetPart then return end
    
    local chance = Options.HitChance.Value
    
    for _, projectile in pairs(ProjectileArray) do
        if type(projectile) == "table" and projectile.isLocal and projectile.position and projectile.velocity then
            local currentSpeed = math.min(projectile.velocity.Magnitude, 999)
            if currentSpeed > 1 then
                if math.random(1, 100) <= chance then
                    local targetDirection = (targetPart.Position - projectile.position).Unit
                    local gravityCompensation = Vector3.new(0, 64, 0) * deltaTime
                    projectile.velocity = (targetDirection * currentSpeed) + gravityCompensation
                end
            end
        end
    end
end))

local validTargets = {}
local auraTask = task.spawn(function()
    while true do
        local delay = Options.MeleeAuraDelay and Options.MeleeAuraDelay.Value or 0.5
        task.wait(delay)
        if not Toggles.MeleeAuraEnable or not Toggles.MeleeAuraEnable.Value or not WeaponsDamageClient then 
            currentMeleeTargetRoot = nil
            continue 
        end
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root then 
            currentMeleeTargetRoot = nil
            continue 
        end
        local origin = root.Position
        local range = Options.MeleeAuraRange.Value
        
        table.clear(validTargets)
        
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and (not LocalPlayer.Team or player.Team ~= LocalPlayer.Team) then
                local pChar = player.Character
                if pChar then
                    local hum = pChar:FindFirstChildWhichIsA("Humanoid")
                    local targetRoot = pChar:FindFirstChild("HumanoidRootPart")
                    if hum and targetRoot and hum.Health > 0 then
                        local dist = (targetRoot.Position - origin).Magnitude
                        if dist <= range then
                            local priority = 3
                            if hum.MaxHealth > 100 or player:GetAttribute("FlagBearer") == true then
                                priority = -2
                            end
                            table.insert(validTargets, {
                                Player = player, Humanoid = hum, Root = targetRoot,
                                Health = hum.Health, IsModel = false, Priority = priority
                            })
                        end
                    end
                end
            end
        end
        if WeaponsTargetsClient then
            for obj in pairs(cachedTargets) do
                if obj.Parent then
                    local primary = obj.PrimaryPart
                    if not primary then
                        for _, child in ipairs(obj:GetDescendants()) do
                            if child:IsA("BasePart") then
                                primary = child
                                break
                            end
                        end
                    end
                    if primary then
                        local dist = (primary.Position - origin).Magnitude
                        if dist <= range then
                            table.insert(validTargets, {
                                Object = obj, Root = primary, Health = 100, IsModel = true, Priority = 1
                            })
                        end
                    end
                else
                    cachedTargets[obj] = nil
                end
            end
        end
        if #validTargets > 0 then
            table.sort(validTargets, function(a, b)
                if a.Priority ~= b.Priority then
                    return a.Priority > b.Priority
                end
                if Toggles.MeleeAuraPriorityLow.Value then
                    return a.Health < b.Health
                elseif Toggles.MeleeAuraPriorityHigh.Value then
                    return a.Health > b.Health
                end
                return false
            end)
            
            currentMeleeTargetRoot = validTargets[1].Root
            local currentDamage = Toggles.CustomDamageToggle.Value and Options.CustomDamageAmount.Value or 50
            for _, target in ipairs(validTargets) do
                if target.IsModel then
                    WeaponsTargetsClient.hitTarget(target.Object, currentDamage)
                else
                    WeaponsDamageClient.dealMelee(target.Player, target.Humanoid, currentDamage)
                end
            end
        else
            currentMeleeTargetRoot = nil
        end
    end
end)

SaveManager:LoadAutoloadConfig()

Library:OnUnload(function()
    if auraTask then task.cancel(auraTask) end
    for _, conn in ipairs(Connections) do conn:Disconnect() end
    if FOVCircle then FOVCircle:Remove() end
    if FOVFilledCircle then FOVFilledCircle:Remove() end
    if TracerLine then TracerLine:Remove() end
    if MeleeTargetTracer then MeleeTargetTracer:Remove() end
    for i = 1, 30 do
        if MeleeRangeLines[i] then MeleeRangeLines[i]:Remove() end
    end
    table.clear(drawingPropCache)
    Library.Unloaded = true
end)
