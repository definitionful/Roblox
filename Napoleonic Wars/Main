local function checkVisibility(startPos, endPos, character)
    local direction = endPos - startPos
    table.clear(dynamicFilterList)
    for i = 1, #filterList do dynamicFilterList[i] = filterList[i] end
    for i = 1, 5 do
        sharedVisibilityParams.FilterDescendantsInstances = dynamicFilterList
        local result = Workspace:Raycast(startPos, direction, sharedVisibilityParams)
        if not result or result.Instance:IsDescendantOf(character) then return true end
        if result.Instance.Transparency > 0.5 or not result.Instance.CanCollide then
            table.insert(dynamicFilterList, result.Instance)
        else
            return false
        end
    end
    return false
end

local function getClosestCharacterToMouse(mousePos, currentCamera, skipMultipoint)
    if not currentCamera then return nil, nil, nil end
    local fovEnabled = Toggles.FOVEnabled.Value
    local fovRadiusSq = Options.FOVRadius.Value * Options.FOVRadius.Value
    local visibleCheck = Toggles.VisibleCheck.Value
    local targetPlayers = Toggles.SilentAimEnabled.Value
    if not targetPlayers then return nil, nil, nil end

    local localChar = LocalPlayer.Character
    table.clear(filterList)
    table.clear(entitiesList)
    table.clear(potentialTargetsList)

    table.insert(filterList, currentCamera)
    if localChar then table.insert(filterList, localChar) end
    if rayExceptionFolder then
        table.insert(filterList, rayExceptionFolder)
    elseif debrisFolder then
        table.insert(filterList, debrisFolder)
    end
    sharedRayParams.FilterDescendantsInstances = filterList
    local camCFramePos = currentCamera.CFrame.Position

    for i, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        local character = player.Character
        if not character then continue end
        
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        local hrp = character:FindFirstChild("HumanoidRootPart") or character.PrimaryPart or character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso")
        
        if not humanoid or not hrp or humanoid.Health <= 0 then continue end

        if player.Team then
            local ignoredTeams = Options.IgnoredTeams.Value
            if ignoredTeams and ignoredTeams[player.Team.Name] then continue end
        end

        if Toggles.InvisibleCheck.Value then
            local head = character:FindFirstChild("Head")
            if head and head.Transparency >= 0.5 then continue end
        end

        table.insert(entitiesList, {character = character, hrp = hrp})
    end

    for i = 1, #entitiesList do
        local entity = entitiesList[i]
        local targetPart = entity.hrp
        if not targetPart or not targetPart.Parent then continue end

        local rootScreenPos, rootOnScreen = currentCamera:WorldToViewportPoint(targetPart.Position)
        if fovEnabled and rootOnScreen then
            local rx, ry = rootScreenPos.X - mousePos.X, rootScreenPos.Y - mousePos.Y
            local rootDistSq = (rx * rx) + (ry * ry)
            if rootDistSq > (fovRadiusSq * 3) then continue end
        end

        if not skipMultipoint then
            local size = targetPart.Size * 0.8
            local cf = targetPart.CFrame
            local hx, hy, hz = size.X / 2, size.Y / 2, size.Z / 2
            for _, offset in ipairs(MULTIPOINT_OFFSETS) do
                local point = cf * Vector3.new(hx * offset.X, hy * offset.Y, hz * offset.Z)
                local screenPos, onScreen = currentCamera:WorldToViewportPoint(point)
                if onScreen then
                    local px, py = screenPos.X - mousePos.X, screenPos.Y - mousePos.Y
                    local distSq = (px * px) + (py * py)
                    if not fovEnabled or distSq <= fovRadiusSq then
                        table.insert(potentialTargetsList, {
                            distanceSq = distSq, pos2D = Vector2.new(screenPos.X, screenPos.Y),
                            part = targetPart, hitPos = point, character = entity.character
                        })
                    end
                end
            end
        else
            local point = targetPart.Position
            local screenPos, onScreen = currentCamera:WorldToViewportPoint(point)
            if onScreen then
                local px, py = screenPos.X - mousePos.X, screenPos.Y - mousePos.Y
                local distSq = (px * px) + (py * py)
                if not fovEnabled or distSq <= fovRadiusSq then
                    table.insert(potentialTargetsList, {
                        distanceSq = distSq, pos2D = Vector2.new(screenPos.X, screenPos.Y),
                        part = targetPart, hitPos = point, character = entity.character
                    })
                end
            end
        end
    end

    table.sort(potentialTargetsList, function(a, b) return a.distanceSq < b.distanceSq end)

    for i = 1, #potentialTargetsList do
        local target = potentialTargetsList[i]
        if visibleCheck then
            local isVisible = checkVisibility(camCFramePos, target.hitPos, target.character)
            if isVisible then return target.pos2D, target.part, target.hitPos end
        else
            return target.pos2D, target.part, target.hitPos
        end
    end
    return nil, nil, nil
end

local silentAimTarget = { part = nil, hitPos = nil }
local currentMeleeTargetRoot = nil

table.insert(Connections, RunService.RenderStepped:Connect(function()
    local currentCamera = Workspace.CurrentCamera
    if not currentCamera then return end

    local mousePos = UserInputService:GetMouseLocation()
    
    if Toggles.SilentAimEnabled.Value then
        local _, hitPart, hitPos = getClosestCharacterToMouse(mousePos, currentCamera, false)
        silentAimTarget.part = hitPart
        silentAimTarget.hitPos = hitPos
    else
        silentAimTarget.part = nil
        silentAimTarget.hitPos = nil
    end

    local fovEnabled = Toggles.FOVEnabled.Value
    local tracerEnabled = Toggles.TracerEnabled.Value

    if fovEnabled then
        local outlineEnabled = Toggles.FOVOutline.Value
        local filledEnabled = Toggles.FOVFilled.Value
        local fovRadius = Options.FOVRadius.Value
        local fovNumSides = Options.FOVNumSides.Value
        setDrawingProp(FOVCircle, "Visible", outlineEnabled)
        setDrawingProp(FOVFilledCircle, "Visible", filledEnabled)
        if outlineEnabled then
            setDrawingProp(FOVCircle, "Position", mousePos)
            setDrawingProp(FOVCircle, "Radius", fovRadius)
            setDrawingProp(FOVCircle, "Thickness", Options.FOVThickness.Value)
            setDrawingProp(FOVCircle, "NumSides", fovNumSides)
            setDrawingProp(FOVCircle, "Color", Options.FOVOutlineColor.Value)
        end
        if filledEnabled then
            setDrawingProp(FOVFilledCircle, "Position", mousePos)
            setDrawingProp(FOVFilledCircle, "Radius", fovRadius)
            setDrawingProp(FOVFilledCircle, "NumSides", fovNumSides)
            setDrawingProp(FOVFilledCircle, "Color", Options.FOVFilledColor.Value)
            setDrawingProp(FOVFilledCircle, "Transparency", Options.FOVFilledTransparency.Value)
        end
    else
        setDrawingProp(FOVCircle, "Visible", false)
        setDrawingProp(FOVFilledCircle, "Visible", false)
    end

    if tracerEnabled then
        local targetPos = getClosestCharacterToMouse(mousePos, currentCamera, true)
        if targetPos then
            setDrawingProp(TracerLine, "Visible", true)
            setDrawingProp(TracerLine, "From", mousePos)
            setDrawingProp(TracerLine, "To", targetPos)
            setDrawingProp(TracerLine, "Color", Options.TracerColor.Value)
            setDrawingProp(TracerLine, "Thickness", Options.TracerThickness.Value)
        else
            setDrawingProp(TracerLine, "Visible", false)
        end
    else
        setDrawingProp(TracerLine, "Visible", false)
    end

    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    
    if Toggles.MeleeAuraEnable.Value and Toggles.MeleeAuraCircle.Value and root then
        local range = Options.MeleeAuraRange.Value
        local rootPos = root.Position - Vector3.new(0, 3, 0)
        local angle = (math.pi * 2) / 30
        local points = {}
        for i = 1, 30 do
            local currentAngle = angle * i
            local point3d = rootPos + Vector3.new(math.cos(currentAngle) * range, 0, math.sin(currentAngle) * range)
            local point2d, onScreen = currentCamera:WorldToViewportPoint(point3d)
            points[i] = {pos = Vector2.new(point2d.X, point2d.Y), onScreen = onScreen}
        end
        for i = 1, 30 do
            local p1 = points[i]
            local p2 = points[i == 30 and 1 or i + 1]
            local line = MeleeRangeLines[i]
            if p1.onScreen or p2.onScreen then
                setDrawingProp(line, "From", p1.pos)
                setDrawingProp(line, "To", p2.pos)
                setDrawingProp(line, "Color", Options.RangeCircleColor.Value)
                setDrawingProp(line, "Visible", true)
            else
                setDrawingProp(line, "Visible", false)
            end
        end
    else
        for i = 1, 30 do setDrawingProp(MeleeRangeLines[i], "Visible", false) end
    end
    
    if Toggles.MeleeAuraEnable.Value and Toggles.MeleeAuraTracer.Value and root and currentMeleeTargetRoot and currentMeleeTargetRoot.Parent then
        local rootPos, rootOnScreen = currentCamera:WorldToViewportPoint(root.Position)
        local targetPos, targetOnScreen = currentCamera:WorldToViewportPoint(currentMeleeTargetRoot.Position)
        if rootOnScreen or targetOnScreen then
            setDrawingProp(MeleeTargetTracer, "From", Vector2.new(rootPos.X, rootPos.Y))
            setDrawingProp(MeleeTargetTracer, "To", Vector2.new(targetPos.X, targetPos.Y))
            setDrawingProp(MeleeTargetTracer, "Color", Options.MeleeTracerColor.Value)
            setDrawingProp(MeleeTargetTracer, "Visible", true)
        else
            setDrawingProp(MeleeTargetTracer, "Visible", false)
        end
    else
        setDrawingProp(MeleeTargetTracer, "Visible", false)
    end
end))

table.insert(Connections, RunService.Heartbeat:Connect(function(deltaTime)
    if not ProjectileArray then 
        locateProjectileArray()
        return 
    end
    if not Toggles.SilentAimEnabled.Value then return end
    local targetPart = silentAimTarget.part
    if not targetPart then return end
    for _, projectile in pairs(ProjectileArray) do
        if type(projectile) == "table" and projectile.isLocal and projectile.position and projectile.velocity then
            local currentSpeed = math.min(projectile.velocity.Magnitude, 999)
            if currentSpeed > 1 then
                local targetDirection = (targetPart.Position - projectile.position).Unit
                local gravityCompensation = Vector3.new(0, 64, 0) * deltaTime
                projectile.velocity = (targetDirection * currentSpeed) + gravityCompensation
            end
        end
    end
end))

local auraTask = task.spawn(function()
    while true do
        local delay = Options.MeleeAuraDelay and Options.MeleeAuraDelay.Value or 0.5
        task.wait(delay)
        if not Toggles.MeleeAuraEnable or not Toggles.MeleeAuraEnable.Value or not WeaponsDamageClient then 
            currentMeleeTargetRoot = nil
            continue 
        end
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root then 
            currentMeleeTargetRoot = nil
            continue 
        end
        local origin = root.Position
        local range = Options.MeleeAuraRange.Value
        local validTargets = {}
        local localTeam = LocalPlayer.Team
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Team ~= localTeam then
                local pChar = player.Character
                if pChar then
                    local hum = pChar:FindFirstChildWhichIsA("Humanoid")
                    local targetRoot = pChar:FindFirstChild("HumanoidRootPart")
                    if hum and targetRoot and hum.Health > 0 then
                        local dist = (targetRoot.Position - origin).Magnitude
                        if dist <= range then
                            table.insert(validTargets, {
                                Player = player, Humanoid = hum, Root = targetRoot,
                                Health = hum.Health, IsModel = false
                            })
                        end
                    end
                end
            end
        end
        if WeaponsTargetsClient then
            for obj in pairs(cachedTargets) do
                if obj.Parent then
                    local primary = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
                    if primary then
                        local dist = (primary.Position - origin).Magnitude
                        if dist <= range then
                            table.insert(validTargets, {
                                Object = obj, Root = primary, Health = 100, IsModel = true
                            })
                        end
                    end
                else
                    cachedTargets[obj] = nil
                end
            end
        end
        if #validTargets > 0 then
            if Toggles.MeleeAuraPriorityLow.Value then
                table.sort(validTargets, function(a, b) return a.Health < b.Health end)
            elseif Toggles.MeleeAuraPriorityHigh.Value then
                table.sort(validTargets, function(a, b) return a.Health > b.Health end)
            end
            currentMeleeTargetRoot = validTargets[1].Root
            local currentDamage = Toggles.CustomDamageToggle.Value and Options.CustomDamageAmount.Value or 50
            for _, target in ipairs(validTargets) do
                if target.IsModel then
                    WeaponsTargetsClient.hitTarget(target.Object, currentDamage)
                else
                    WeaponsDamageClient.dealMelee(target.Player, target.Humanoid, currentDamage)
                end
            end
        else
            currentMeleeTargetRoot = nil
        end
    end
end)

SaveManager:LoadAutoloadConfig()

Library:OnUnload(function()
    if auraTask then task.cancel(auraTask) end
    for _, conn in ipairs(Connections) do conn:Disconnect() end
    if FOVCircle then FOVCircle:Remove() end
    if FOVFilledCircle then FOVFilledCircle:Remove() end
    if TracerLine then TracerLine:Remove() end
    if MeleeTargetTracer then MeleeTargetTracer:Remove() end
    for i = 1, 30 do
        if MeleeRangeLines[i] then MeleeRangeLines[i]:Remove() end
    end
    table.clear(drawingPropCache)
    Library.Unloaded = true
end)
