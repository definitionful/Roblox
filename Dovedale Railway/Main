if getgenv()._UnloadPreviousInstance then
    pcall(getgenv()._UnloadPreviousInstance)
end

local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/definitionful/Roblox/refs/heads/main/Library"))()
local ThemeManager = loadstring(game:HttpGet("https://raw.githubusercontent.com/definitionful/Roblox/refs/heads/main/Dovedale%20Railway/ThemeManager"))()
local SaveManager = loadstring(game:HttpGet("https://raw.githubusercontent.com/violin-suzutsuki/LinoriaLib/refs/heads/main/addons/SaveManager.lua"))()

getgenv()._UnloadPreviousInstance = function()
    if Library and not Library.Unloaded then
        Library:Unload()
    end
end

local Players = game:GetService("Players")
local PathfindingService = game:GetService("PathfindingService")
local VirtualInputManager = game:GetService("VirtualInputManager")
local GuiService = game:GetService("GuiService")
local localPlayer = Players.LocalPlayer

local globalListeners = {}

local Window = Library:CreateWindow({
    Title = 'Dovedale Railway',
    Center = true,
    AutoShow = true,
    TabPadding = 8,
    MenuFadeTime = 0.2
})

local Toggles = getgenv().Toggles
local Options = getgenv().Options

local Tabs = {
    Placeholder = Window:AddTab('Placeholder'),
    Settings = Window:AddTab('Settings')
}

local boxOptions = {}
local boxMap = {}
local boxSystem = workspace:FindFirstChild("BoxSystem")

if boxSystem then
    for _, boxFolder in ipairs(boxSystem:GetChildren()) do
        local fullName = boxFolder:FindFirstChild("FullName")
        local minXP = boxFolder:FindFirstChild("MinXP")
        
        if fullName and minXP and fullName:IsA("StringValue") and minXP:IsA("NumberValue") then
            local optionString = string.format("%s (%d XP)", fullName.Value, minXP.Value)
            table.insert(boxOptions, optionString)
            boxMap[optionString] = { Folder = boxFolder, FullName = fullName.Value }
        end
    end
    table.sort(boxOptions)
end

local activeTask = nil
local defaultWalkSpeed = 16
local incomingSignalActive = false
local signalTimeoutTask = nil
local incomingStrokeCount = 0
local strokeCountingTask = nil
local receivedAcknowledgment = false
local currentOwnedBoxAbbreviation = nil
local lastSelfActionTime = 0

local function onSelfAction(player)
    if player == localPlayer then
        lastSelfActionTime = os.clock()
    end
end

local function triggerIncomingSignal()
    incomingSignalActive = true
    if signalTimeoutTask then task.cancel(signalTimeoutTask) end
    signalTimeoutTask = task.delay(15, function()
        incomingSignalActive = false
    end)
end

local function countStroke()
    if os.clock() - lastSelfActionTime < 1.5 then return end
    
    incomingStrokeCount = incomingStrokeCount + 1
    if strokeCountingTask then task.cancel(strokeCountingTask) end
    strokeCountingTask = task.delay(1.2, function()
        if incomingStrokeCount == 1 then
            receivedAcknowledgment = true
        end
        triggerIncomingSignal()
        incomingStrokeCount = 0
    end)
end

local function getDirectoriesToSearch()
    return {
        workspace:FindFirstChild("Bells"),
        workspace:FindFirstChild("PenguinTelegraph")
    }
end

local function updateGlobalListeners()
    local ownedBoxAbbreviation = nil
    if boxSystem then
        for _, boxFolder in ipairs(boxSystem:GetChildren()) do
            local data = boxFolder:FindFirstChild("Data")
            local host = data and data:FindFirstChild("BoxHost")
            if host and host.Value == localPlayer then
                ownedBoxAbbreviation = boxFolder.Name
                break
            end
        end
    end

    if ownedBoxAbbreviation == currentOwnedBoxAbbreviation then return end
    currentOwnedBoxAbbreviation = ownedBoxAbbreviation

    for _, conn in ipairs(globalListeners) do conn:Disconnect() end
    table.clear(globalListeners)

    if not ownedBoxAbbreviation then return end

    for _, directory in ipairs(getDirectoriesToSearch()) do
        if directory then
            for _, connectionFolder in ipairs(directory:GetChildren()) do
                local target = connectionFolder:FindFirstChild(ownedBoxAbbreviation)
                if target then
                    local bell = target:FindFirstChild("Bell") or target
                    local sys = bell:FindFirstChild("System")
                    local cd = sys and sys:FindFirstChildWhichIsA("ClickDetector", true)
                    
                    if cd then
                        table.insert(globalListeners, cd.MouseClick:Connect(onSelfAction))
                    end
                    
                    local anims = sys and sys:FindFirstChild("BellAnimations")
                    local ring = anims and anims:FindFirstChild("Ring")
                    
                    if ring then
                        table.insert(globalListeners, ring:GetPropertyChangedSignal("Transparency"):Connect(function()
                            if ring.Transparency == 0 then countStroke() end
                        end))
                    end
                end
            end
        end
    end

    for _, folder in ipairs(workspace:GetChildren()) do
        if (string.find(folder.Name, "TokenInstrument") or string.find(folder.Name, "TokenlessBlocks")) and string.find(folder.Name, ownedBoxAbbreviation) then
            for _, boxName in ipairs({"BoxA", "BoxB"}) do
                local boxModel = folder:FindFirstChild(boxName)
                local plunger = boxModel and boxModel:FindFirstChild("Plunger")
                local prompt = plunger and plunger:FindFirstChildWhichIsA("ProximityPrompt", true)
                
                if prompt then
                    table.insert(globalListeners, prompt.PromptButtonHoldBegan:Connect(onSelfAction))
                    table.insert(globalListeners, prompt.Triggered:Connect(onSelfAction))
                end
            end

            local states = folder:FindFirstChild("States")
            if states then
                for _, boxName in ipairs({"BoxA", "BoxB"}) do
                    local stateTarget = states:FindFirstChild(boxName)
                    local pd = stateTarget and stateTarget:FindFirstChild("PlungerDown")
                    if pd then
                        table.insert(globalListeners, pd:GetPropertyChangedSignal("Value"):Connect(function()
                            if pd.Value == true then countStroke() end
                        end))
                    end
                end
            end
        end
    end
end

task.spawn(function()
    while true do
        updateGlobalListeners()
        task.wait(5)
    end
end)

local function stopCurrentProcess()
    if activeTask then
        task.cancel(activeTask)
        activeTask = nil
    end
    local character = localPlayer.Character
    if character then
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        local hrp = character:FindFirstChild("HumanoidRootPart")
        if humanoid and humanoid.Health > 0 then
            if humanoid.WalkSpeed == 35 then
                humanoid.WalkSpeed = defaultWalkSpeed
            end
            if hrp then
                humanoid:MoveTo(hrp.Position)
            end
        end
    end
end

local function handlePathfinding(hrp, humanoid, tpOut, prompt)
    local raycastParams = RaycastParams.new()
    raycastParams.FilterDescendantsInstances = {localPlayer.Character}
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude

    local directRay = workspace:Raycast(hrp.Position, tpOut.Position - hrp.Position, raycastParams)
    local hasDirectPath = not directRay or directRay.Instance:IsDescendantOf(tpOut) or (directRay.Position - tpOut.Position).Magnitude < 3

    if hasDirectPath then
        humanoid:MoveTo(tpOut.Position)
        local directTimeout = os.clock() + 10
        repeat
            task.wait(0.05)
        until not hrp or not hrp.Parent or humanoid.Health <= 0 or (hrp.Position - tpOut.Position).Magnitude <= prompt.MaxActivationDistance or os.clock() > directTimeout
        return
    end

    local path = PathfindingService:CreatePath({
        AgentRadius = 1.5,
        AgentHeight = 5,
        AgentCanJump = true,
        AgentCanClimb = false,
        AgentMaxSlope = 89,
        WaypointSpacing = 2
    })

    path:ComputeAsync(hrp.Position, tpOut.Position)

    if path.Status == Enum.PathStatus.Success then
        local waypoints = path:GetWaypoints()
        for _, waypoint in ipairs(waypoints) do
            if not hrp or not hrp.Parent or humanoid.Health <= 0 then break end
            if (hrp.Position - tpOut.Position).Magnitude <= prompt.MaxActivationDistance then break end
            
            humanoid:MoveTo(waypoint.Position)
            if waypoint.Action == Enum.PathWaypointAction.Jump then
                humanoid.Jump = true
            end
            
            local timeout = os.clock() + 4
            local lastPos = hrp.Position
            local stuckTime = os.clock()
            
            repeat
                task.wait(0.05)
                if not hrp or not hrp.Parent then break end
                if (hrp.Position - lastPos).Magnitude < 0.5 then
                    if os.clock() - stuckTime > 1 then
                        humanoid.Jump = true
                        stuckTime = os.clock()
                    end
                else
                    lastPos = hrp.Position
                    stuckTime = os.clock()
                end
            until not hrp or not hrp.Parent or (Vector3.new(hrp.Position.X, 0, hrp.Position.Z) - Vector3.new(waypoint.Position.X, 0, waypoint.Position.Z)).Magnitude < 2 or os.clock() > timeout
        end
    else
        humanoid:MoveTo(tpOut.Position)
        local failTimeout = os.clock() + 10
        repeat 
            task.wait(0.1) 
        until not hrp or not hrp.Parent or humanoid.Health <= 0 or (hrp.Position - tpOut.Position).Magnitude <= prompt.MaxActivationDistance or os.clock() > failTimeout
    end
end

local function autoFarmCycle(highestXP, playerGui)
    local hasBox = false
    local validBoxes = {}
    local hasEnoughXP = false
    local selectedBoxes = Options.BoxSelection.Value

    if boxSystem and highestXP then
        for _, boxFolder in ipairs(boxSystem:GetChildren()) do
            local fullName = boxFolder:FindFirstChild("FullName")
            local minXP = boxFolder:FindFirstChild("MinXP")
            
            if not (fullName and minXP) then continue end
            
            local optionString = string.format("%s (%d XP)", fullName.Value, minXP.Value)
            if not selectedBoxes[optionString] then continue end
            if highestXP.Value < minXP.Value then continue end
            
            hasEnoughXP = true
            local data = boxFolder:FindFirstChild("Data")
            local host = data and data:FindFirstChild("BoxHost")
            
            if host and host:IsA("ObjectValue") then
                if host.Value == localPlayer then
                    hasBox = true
                elseif host.Value == nil then
                    local isCamped = false
                    
                    if Toggles.AvoidCampedBoxes and Toggles.AvoidCampedBoxes.Value then
                        local tpOut = boxFolder:FindFirstChild("TpOut")
                        local prompt = tpOut and tpOut:FindFirstChildWhichIsA("ProximityPrompt", true)
                        
                        if tpOut and prompt then
                            for _, p in ipairs(Players:GetPlayers()) do
                                if p ~= localPlayer then
                                    local char = p.Character
                                    local p_hrp = char and char:FindFirstChild("HumanoidRootPart")
                                    
                                    if p_hrp and (p_hrp.Position - tpOut.Position).Magnitude <= prompt.MaxActivationDistance then
                                        isCamped = true
                                        break
                                    end
                                end
                            end
                        end
                    end
                    
                    if not isCamped then
                        table.insert(validBoxes, boxMap[optionString])
                    end
                end
            end
        end
    end

    if hasBox or not hasEnoughXP or #validBoxes == 0 then
        if hasBox or not hasEnoughXP then
            Toggles.EnableToggle:SetValue(false)
            return false
        end
        task.wait(0.5)
        return true
    end

    local selectedBoxInfo = validBoxes[math.random(1, #validBoxes)]
    local boxFolder = selectedBoxInfo.Folder

    local character = localPlayer.Character or localPlayer.CharacterAdded:Wait()
    local hrp = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChild("Humanoid")
    
    if not hrp or not humanoid or humanoid.Health <= 0 then 
        task.wait(1)
        return true 
    end

    local startPos = hrp.Position
    local topbar = playerGui and playerGui:FindFirstChild("TopbarStandardClipped")
    local container = topbar and topbar:FindFirstChild("ClippedContainer")
    local dropdown = container and container:FindFirstChild("Dropdown")
    local scroller = dropdown and dropdown:FindFirstChild("DropdownScroller")

    if not scroller then
        task.wait(1)
        return true
    end

    local targetSignalBox
    local formattedName = string.gsub(selectedBoxInfo.FullName, " ", "_")

    for _, child in ipairs(scroller:GetChildren()) do
        if string.find(child.Name, formattedName) and (string.find(child.Name, "_Signal_Box") or string.find(child.Name, "/Signal_Box")) then
            targetSignalBox = child
            break
        end
    end

    if targetSignalBox then
        local iconButton = targetSignalBox:FindFirstChild("IconButton")
        local menu = iconButton and iconButton:FindFirstChild("Menu")
        local iconSpot = menu and menu:FindFirstChild("IconSpot")
        local targetButton = iconSpot and iconSpot:FindFirstChild("ClickRegion")

        if targetButton then
            if humanoid.Sit then
                humanoid.Sit = false
                task.wait(0.2)
            end

            if firesignal then
                firesignal(targetButton.MouseButton1Click)
                firesignal(targetButton.Activated)
            else
                local absolutePos = targetButton.AbsolutePosition
                local absoluteSize = targetButton.AbsoluteSize
                local inset = GuiService:GetGuiInset()
                local clickX = (absolutePos.X + (absoluteSize.X / 2)) + inset.X
                local clickY = (absolutePos.Y + (absoluteSize.Y / 2)) + inset.Y

                VirtualInputManager:SendMouseButtonEvent(clickX, clickY, 0, true, game, 0)
                task.wait(0.05)
                VirtualInputManager:SendMouseButtonEvent(clickX, clickY, 0, false, game, 0)
            end
            
            local pendingTeleportValid = true
            local cancelConnections = {}

            table.insert(cancelConnections, humanoid:GetPropertyChangedSignal("Jump"):Connect(function()
                if humanoid.Jump then pendingTeleportValid = false end
            end))

            table.insert(cancelConnections, humanoid:GetPropertyChangedSignal("SeatPart"):Connect(function()
                if humanoid.SeatPart ~= nil then pendingTeleportValid = false end
            end))

            local waitTimeout = os.clock() + 5
            repeat 
                task.wait(0.1)
                character = localPlayer.Character
                hrp = character and character:FindFirstChild("HumanoidRootPart")
            until (hrp and (hrp.Position - startPos).Magnitude > 5) or os.clock() > waitTimeout or not pendingTeleportValid

            local tpOut = boxFolder:WaitForChild("TpOut", 5)
            local prompt = tpOut and (tpOut:WaitForChild("ProximityPrompt", 5) or tpOut:FindFirstChildWhichIsA("ProximityPrompt"))

            if pendingTeleportValid and tpOut and prompt and hrp and humanoid.Health > 0 then
                if Options.MethodSelection.Value == "Legit" then
                    defaultWalkSpeed = humanoid.WalkSpeed
                    humanoid.WalkSpeed = 35
                    
                    handlePathfinding(hrp, humanoid, tpOut, prompt)
                    
                    humanoid.WalkSpeed = defaultWalkSpeed
                    if hrp and hrp.Parent and (hrp.Position - tpOut.Position).Magnitude <= prompt.MaxActivationDistance then
                        humanoid:MoveTo(hrp.Position)
                        task.wait(0.1)
                        fireproximityprompt(prompt)
                    end
                elseif Options.MethodSelection.Value == "Instant" then
                    hrp.CFrame = tpOut.CFrame
                    task.wait(0.2)
                    if hrp and hrp.Parent and (hrp.Position - tpOut.Position).Magnitude <= prompt.MaxActivationDistance then
                        fireproximityprompt(prompt)
                    end
                end
            end

            for _, conn in ipairs(cancelConnections) do conn:Disconnect() end
            table.clear(cancelConnections)
        end
    end

    local claimTimeout = os.clock() + 10
    while Toggles.EnableToggle.Value and os.clock() < claimTimeout do
        local data = boxFolder:FindFirstChild("Data")
        local host = data and data:FindFirstChild("BoxHost")
        if host then
            if host.Value == localPlayer then
                Toggles.EnableToggle:SetValue(false)
                return false
            elseif host.Value ~= nil then
                break
            end
        end
        task.wait(0.1)
    end
    
    task.wait(0.1)
    return true
end

local function findTargetBellAndData(ownedBoxAbbreviation, hrp)
    local possibleBells = {}
    for _, directory in ipairs(getDirectoriesToSearch()) do
        if directory then
            for _, connectionFolder in ipairs(directory:GetChildren()) do
                if connectionFolder:IsA("Folder") or connectionFolder:IsA("Model") then
                    local target = connectionFolder:FindFirstChild(ownedBoxAbbreviation)
                    if target then
                        table.insert(possibleBells, target:FindFirstChild("Bell") or target)
                    end
                end
            end
        end
    end

    local targetBell, targetClickDetector
    local closestDist = math.huge

    for _, b in ipairs(possibleBells) do
        local dist = (b:GetPivot().Position - hrp.Position).Magnitude
        if dist < closestDist then
            local sys = b:FindFirstChild("System")
            local clickHitbox = sys and sys:FindFirstChild("ClickHitbox")
            local cd = clickHitbox and clickHitbox:FindFirstChild("ClickDetector")
            if cd and dist <= cd.MaxActivationDistance then
                closestDist = dist
                targetBell = b
                targetClickDetector = cd
            end
        end
    end

    local targetData
    local activeBoxIdentity = "BoxA"
    closestDist = math.huge
    local activeBoxInstrument = nil

    for _, folder in ipairs(workspace:GetChildren()) do
        if (string.find(folder.Name, "TokenInstrument") or string.find(folder.Name, "TokenlessBlocks")) and string.find(folder.Name, ownedBoxAbbreviation) then
            for _, boxName in ipairs({"BoxA", "BoxB"}) do
                local boxModel = folder:FindFirstChild(boxName)
                local plunger = boxModel and boxModel:FindFirstChild("Plunger")
                local prompt = plunger and plunger:FindFirstChildWhichIsA("ProximityPrompt")
                
                if prompt then
                    local dist = (plunger:GetPivot().Position - hrp.Position).Magnitude
                    if dist < closestDist and dist <= prompt.MaxActivationDistance then
                        closestDist = dist
                        targetData = {Plunger = plunger, Prompt = prompt}
                        activeBoxIdentity = boxName
                        activeBoxInstrument = folder
                    end
                end
            end
        end
    end
    
    return targetBell, targetClickDetector, targetData, activeBoxIdentity, activeBoxInstrument
end

local function triggerBellSequence()
    local ownedBoxAbbreviation = nil
    local boxSys = workspace:FindFirstChild("BoxSystem")
    
    if boxSys then
        for _, boxFolder in ipairs(boxSys:GetChildren()) do
            local data = boxFolder:FindFirstChild("Data")
            local host = data and data:FindFirstChild("BoxHost")
            if host and host.Value == localPlayer then
                ownedBoxAbbreviation = boxFolder.Name
                break
            end
        end
    end

    if not ownedBoxAbbreviation then return end

    local char = localPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local targetBell, targetClickDetector, targetData, activeBoxIdentity, activeBoxInstrument = findTargetBellAndData(ownedBoxAbbreviation, hrp)
    local isListeningMode = false

    if targetData and activeBoxInstrument then
        local states = activeBoxInstrument:FindFirstChild("States")
        if states then
            local oppTarget = (activeBoxIdentity == "BoxA") and "BoxB" or "BoxA"
            local stateTarget = states:FindFirstChild(oppTarget)
            local pd = stateTarget and stateTarget:FindFirstChild("PlungerDown")
            if pd and pd.Value == true then
                isListeningMode = true
            end
        end
    elseif targetBell then
        isListeningMode = incomingSignalActive
    end

    if not targetBell and not targetData then return end

    if isListeningMode then
        task.wait(math.random(1, 3) / 10)
        incomingSignalActive = false
    end

    local selectedCode = Options.BellCodeDropdown.Value
    local sequenceString = selectedCode:match("%(([%d%-]+)%)")
    
    if sequenceString then
        local sequence = {}
        for num in sequenceString:gmatch("%d+") do
            table.insert(sequence, tonumber(num))
        end

        local excludedFromAttention = {["2"] = true, ["6"] = true, ["2-5-5"] = true, ["4-5-5"] = true}
        local isMovementSequence = (sequenceString == "4" or sequenceString == "3-1" or sequenceString == "2-2-1" or sequenceString == "5" or sequenceString == "1-4" or sequenceString == "2-3")

        if Toggles.CallAttentionToggle and Toggles.CallAttentionToggle.Value and not excludedFromAttention[sequenceString] then
            if not isListeningMode then
                receivedAcknowledgment = false

                if targetClickDetector and type(fireclickdetector) == "function" then
                    lastSelfActionTime = os.clock()
                    fireclickdetector(targetClickDetector)
                end

                if targetData and targetData.Prompt then
                    local keyCode = targetData.Prompt.KeyboardKeyCode
                    local holdDuration = targetData.Prompt.HoldDuration
                    lastSelfActionTime = os.clock()
                    VirtualInputManager:SendKeyEvent(true, keyCode, false, game)
                    task.wait(holdDuration + 0.1)
                    VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
                end

                local waitTimeout = os.clock() + 15
                while not receivedAcknowledgment and os.clock() < waitTimeout do
                    task.wait(0.1)
                end
                
                if not receivedAcknowledgment then return end
                task.wait(math.random(1, 3) / 10)
            end
            incomingSignalActive = false
            receivedAcknowledgment = false
        end

        for i, count in ipairs(sequence) do
            for j = 1, count do
                local isFinalStroke = (i == #sequence and j == count)
                
                if targetClickDetector and type(fireclickdetector) == "function" then
                    lastSelfActionTime = os.clock()
                    fireclickdetector(targetClickDetector)
                end

                if targetData and targetData.Prompt then
                    local keyCode = targetData.Prompt.KeyboardKeyCode
                    local holdDuration = targetData.Prompt.HoldDuration
                    lastSelfActionTime = os.clock()
                    VirtualInputManager:SendKeyEvent(true, keyCode, false, game)
                    
                    if isListeningMode and isMovementSequence and isFinalStroke and activeBoxInstrument then
                        local states = activeBoxInstrument:FindFirstChild("States")
                        local tokenOut = states and states:FindFirstChild("TokenOut")
                        
                        if tokenOut then
                            if tokenOut.Value ~= true then
                                local thread = coroutine.running()
                                local conn
                                local timer
                                
                                conn = tokenOut:GetPropertyChangedSignal("Value"):Connect(function()
                                    if tokenOut.Value == true then
                                        conn:Disconnect()
                                        task.cancel(timer)
                                        task.spawn(thread)
                                    end
                                end)
                                
                                timer = task.delay(15, function()
                                    conn:Disconnect()
                                    task.spawn(thread)
                                end)
                                
                                coroutine.yield()
                            end
                        else
                            task.wait(holdDuration + 0.1)
                        end
                    else
                        task.wait(holdDuration + 0.1)
                    end
                    
                    VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
                end
                
                if j < count then
                    task.wait(0.2)
                end
            end
            if i < #sequence then
                task.wait(0.6)
            end
        end
    end
    task.wait(0.5)
end

local PlaceholderGroup = Tabs.Placeholder:AddLeftGroupbox('Selection')

PlaceholderGroup:AddToggle('EnableToggle', { Text = 'Enable', Default = false }):OnChanged(function()
    if not Toggles.EnableToggle.Value then
        stopCurrentProcess()
        return
    end

    stopCurrentProcess()

    activeTask = task.spawn(function()
        local highestXP = localPlayer:WaitForChild("Highest_XP", 5)
        local playerGui = localPlayer:WaitForChild("PlayerGui", 5)

        while Toggles.EnableToggle.Value do
            local shouldContinue = autoFarmCycle(highestXP, playerGui)
            if not shouldContinue then break end
        end
    end)
end)

PlaceholderGroup:AddToggle('AvoidCampedBoxes', { Text = 'Avoid Camped Boxes', Default = true })

PlaceholderGroup:AddDropdown('MethodSelection', {
    Values = {'Legit', 'Instant'},
    Default = 1,
    Multi = false,
    Text = 'Method'
})

PlaceholderGroup:AddDropdown('BoxSelection', {
    Values = boxOptions,
    Default = 0,
    Multi = true,
    Text = 'Select Box'
})

local BellsGroup = Tabs.Placeholder:AddRightGroupbox('Bell Codes')

local bellCodeOptions = {
    "Call attention (1)", "Express pax (4)", "Ordinary pax (3-1)", "Empty stock (2-2-1)",
    "Freight <60mph (5)", "Special pax (1-4)", "Loco(s) (2-3)", "Cancelling (3-5)",
    "Wrong description (5-3)", "Entering section (2)", "Out of section (2-1)",
    "Block back out home (3-3)", "Shunt forward (3-3-2)", "Obstruction danger (6)",
    "Stop & examine (7)", "Obstruction removed (2-1-2)", "Runaway wrong dir (2-5-5)",
    "Runaway right dir (4-5-5)", "Open box (5-5-5)", "Close box (7-5-5)", "Test equipment (16)"
}

BellsGroup:AddToggle('CallAttentionToggle', { Text = 'Call Attention First', Default = false })

BellsGroup:AddDropdown('BellCodeDropdown', {
    Values = bellCodeOptions,
    Default = 1,
    Multi = false,
    Text = 'Select Sequence'
})

BellsGroup:AddButton('Trigger Sequence', function()
    task.spawn(triggerBellSequence)
end)

local MenuGroup = Tabs.Settings:AddLeftGroupbox('Menu')

MenuGroup:AddToggle('WatermarkToggle', { Text = 'Watermark', Default = false }):OnChanged(function()
    Library:SetWatermarkVisibility(Toggles.WatermarkToggle.Value)
end)

MenuGroup:AddToggle('KeybindsToggle', { Text = 'Keybinds', Default = false }):OnChanged(function()
    Library.KeybindFrame.Visible = Toggles.KeybindsToggle.Value
end)

Library:SetWatermark('Dovedale Railway Client')
Library:SetWatermarkVisibility(false)

ThemeManager:SetLibrary(Library)
SaveManager:SetLibrary(Library)
ThemeManager:SetFolder('Dovedale Railway')
SaveManager:SetFolder('Dovedale Railway')
SaveManager:IgnoreThemeSettings()
ThemeManager:ApplyToTab(Tabs.Settings)
SaveManager:BuildConfigSection(Tabs.Settings)
SaveManager:LoadAutoloadConfig()

Library:OnUnload(function()
    stopCurrentProcess()

    for _, conn in ipairs(globalListeners) do 
        conn:Disconnect() 
    end
    table.clear(globalListeners)
    
    Library.Unloaded = true
end)
